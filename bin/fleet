#!/usr/bin/env bash
# fleet — run a project's agent fleet: the COORDINATOR in the docs hub, and
# WORKER sessions in code-repo worktrees. Agent-agnostic core: each CLI
# (claude, cursor, ...) is an agent pack (packs/<name>/pack.sh); a project
# enables packs via AGENTS="..." in its .env (first = default), pick one per
# session with -a/--agent.
#
#   fleet                          launch/resume the COORDINATOR in the project's hub
#   fleet w <name> [base]          create/reopen a WORKER worktree + launch the agent
#   fleet --machine M ...          run the session on machine M (default: local)
#   fleet r [w <name>|hub|del <n>] shorthand for the project's remote machine
#   fleet machines | status        the project's machines / the whole tree (--json)
#   fleet peek/send M <win> [text] read or type into a session's terminal
#   fleet ls | del <n> | prune [--windows]  list / guarded delete / merged worktrees
#                              (+ orphan tmux windows with prune --windows)
#   fleet refresh [<name>]         re-run every enabled pack's worker setup
#   fleet add-agent <pack>         enable a pack for the project (+ refresh worktrees)
#   fleet agents | doctor          enabled packs / per-pack install+login status
#   fleet sync-remote [M]          ship this engine to the project's VM(s) and rebuild
#
# Project resolved by --project / inherited $FLEET_CONF / $FLEET_PROJECT / cwd
# (repo, hub or worktree) — no implicit default. Explicit --project always wins
# over an inherited FLEET_CONF (parent coordinator env). Machines are a global
# pool ($FLEET_HOME/machines/*.env);
# a project selects them with MACHINES="local vm" in its .env ("local" implicit).
# A single legacy REMOTE_HOST (+ REMOTE_CONTAINER / REMOTE_TMUX / REMOTE_PROJECT /
# REMOTE_ENGINE_DIR) still works, synthesized as a machine named "remote".
# Every session runs inside tmux (local mirrors remote), so it survives
# disconnects and is observable/controllable (fleet peek/send, fleet r broadcast).
set -euo pipefail

SELF_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
. "$SELF_DIR/fleet-config.sh"
. "$SELF_DIR/fleet-pass.sh"   # headless review pass primitive + `fleet judge`
. "$SELF_DIR/fleet-race.sh"   # `fleet race`
. "$SELF_DIR/fleet-fanin.sh"  # `fleet fanin` (optional)
NEW_WORKER="$SELF_DIR/new-worker"

usage() {
  cat >&2 <<'EOF'
usage: fleet [--project P] [-a PACK] [--machine M] [--host H] [--force] <subcommand>
  (no subcommand)      launch/resume the COORDINATOR in the project's docs hub
                       (in tmux; --machine picks where, default: local)
  w <name> [base]      create/reopen a worker worktree + launch the agent (tmux)
  dispatch [--auto] [--difficulty D] [--kind K] [--escalate] [--deliverable [pr|push]]
           [--scope GLOBS] [--checks LIST] [--spec FILE] [--model M] <name> "<task>" [base]
                       headless worker in a detached tmux window (for an
                       agent-coordinator): create/reopen the worktree, run the
                       task non-interactively. --machine M dispatches on a VM
                       (delegated to its container). --auto routes pack+model via
                       configurable preferences (--difficulty D, --kind K, --escalate).
                       --model M picks the worker model explicitly. --deliverable,
                       --scope (path allowlist) and --checks (e.g. scope:blocking)
                       — or a --spec FILE of those key=value lines — are the
                       structured task spec; the scope is enforced on exit and by
                       `fleet gate` (advisory unless :blocking). Monitor:
                       fleet attach / ls (w and dispatch refuse when the target
                       machine is at its limit; --force skips the guard)
  route [--difficulty D] [--kind K] [--escalate] [--task T]
                       print pack:model chosen by task routing preferences
  attach               attach the local machine's tmux session (all its windows)
  wait [<name>]        block until dispatched worker(s) finish, then report rc
  machines             the project's machines (selected + registry pool)
  status [--all] [--json] [--remote]  the whole tree (projects/machines/
                       sessions/queue); --remote also gathers VM sessions via ssh
  context [--role R] [--json] [--budget N]  what an agent auto-reads at launch
                       (per role, with ~token estimates); --budget N exits non-zero
                       if a role's front-load exceeds N tokens
  feedback <config|seen|record|list|prune>  conversation-feedback routine state:
                       `config` reports the resolved model/runner knobs (docs/04);
                       the rest are the machine-wide dedup "seen ledger" (see
                       chats --scan)
  peek <machine> <win>     dump a session's terminal (tmux capture-pane)
  send <machine> <win> "<text>"  type <text>+Enter into a session
  global [status|edit] install/rewire one per-user instructions file into every
                       CLI (machine-wide, no project); status = report only
  r [w <n>|hub|del <n>|broadcast "<msg>"]   shorthand for --machine <remote>:
                       bare = attach its tmux; w/hub open there; del removes a
                       remote worker; broadcast types into every remote window
  ls                   list local CODE_REPO worktrees (session markers; machine
                       header is a reminder). Live remote sessions:
                       status --remote / peek — not this command
  del <name>           remove a worktree (refuses if uncommitted; also reaps
                       leftover window/state when the worktree is already gone)
  prune [--windows]    remove every worktree whose branch is merged; always
                       reaps idle `_done-*` orphan panes. --windows also reaps
                       other orphan tmux windows (no matching worktree, or pane
                       path "(deleted)"). Live orphans need --force; without
                       --windows, non-_done- orphans are only reported
  refresh [<name>]     re-run enabled packs' worker setup (one worktree, or all)
  add-agent <pack>     enable a pack for this project, then refresh worktrees
  agents               enabled packs for this project (default first)
  gate [--review] [--scope GLOBS]  run the project's declared pre-PR checks (GATE_CMDS in
                       the .env, one command per line): auto-fixes run inside
                       the commands, only what still fails is printed. No
                       GATE_CMDS = no-op. Workers run it before opening a PR.
                       --review (or GATE_REVIEW=1) then runs the advisory judge.
  judge [--base REF] [--task T] [--with pack[:model]]
                       one fresh headless model pass reviews this worktree's diff
                       against its task: findings + VERDICT, terminal only, never
                       blocks. Pack/model come from the router (ROUTE_KIND_JUDGE).
  race run|ls|judge|comment|steer  fan one task to N worktrees (--packs "a b"),
                       a judge pass compares + drafts markdown review comments,
                       `steer` re-dispatches them to the losing worktrees.
  fanin [--group K] [--dry-run] [<worker>...]
                       OPTIONAL: a lead pass folds K workers' results into one
                       structured report so the hub reads ~1 report, not N.
  chats [<worker>]     per-pack pointer to the conversation recorded in the
                       worktree (bare = the hub/coordinator); read it to reprise
                       a dead/other agent's session (transcripts are not portable)
  chats --scan [--all] [--parse] [--json]  fleet-wide inventory of recorded
                       conversations (hub + all worktrees); --parse attaches each
                       claude transcript's method signal (conversation-feedback input)
  doctor [--write-probe]  per-pack status: installed? version? logged in?
                       --write-probe [--machine M] also does a real witness write
                       in auto mode to prove the box can actually write
  sync-remote [M]      ship this engine to the project's VM(s) (bundle+build)
  issue new|start|review|block|done|bootstrap  the project's GitHub issue queue
                       (QUEUE_KIND=github): file an issue with its labels + board
                       column (+ sub-issue link), move it through the lifecycle
                       (board Status + status:* label + comment, in one call), or
                       bootstrap a queue repo (labels, board, README). fleet issue -h
  init <name> [--code PATH] [...] register a NEW project. With --code: an
                       existing repo. WITHOUT --code: scaffold from scratch
                       (private GitHub repo + hub + github queue). fleet init -h
Legacy aliases still work: --ls, --del <name>, -r [...].
Companions: fleet-assess (hub maturity), fleet-queue (queue config), fleet-migrate.
EOF
  exit 2
}

proj="" agent="" host="" machine="" force="" sub=""
while :; do
  case "${1:-}" in
    --project) proj="${2:-}"; shift 2 ;;
    -a|--agent) agent="${2:-}"; shift 2 ;;
    --machine) machine="${2:-}"; shift 2 ;;
    --host) host="${2:-}"; shift 2 ;;
    --force) force=1; shift ;;
    -r|--remote) sub="r"; shift; break ;;
    --ls) sub="ls"; shift; break ;;
    --del) sub="del"; shift; break ;;
    -h|--help) usage ;;
    *) break ;;
  esac
done
if [ -z "$sub" ]; then
  case "${1:-}" in
    init)  # project registration needs no resolved project — delegate now
      shift
      case "${1:-}" in -h|--help|"") exec "$SELF_DIR/fleet-init" ;; esac
      exec "$SELF_DIR/fleet-init" "$@" ;;
    issue)  # help needs no resolved project (the rest does: the queue keys live in it)
      case "${2:-}" in ""|-h|--help) exec python3 "$SELF_DIR/fleet-issue.py" -h ;; esac
      sub="issue"; shift ;;
    ""|hub) sub="hub"; [ $# -gt 0 ] && shift ;;
    w|worker|r|remote|ls|del|prune|refresh|add-agent|agents|gate|judge|race|fanin|chats|doctor|sync-remote|dispatch|attach|wait|retry|global|machines|status|context|feedback|peek|send|route|_dispatch-run)
      sub="$1"; [ "$sub" = worker ] && sub=w; [ "$sub" = remote ] && sub=r; shift ;;
    -*) echo "error: unknown option '$1'" >&2; exit 2 ;;
    *)
      echo "error: unknown subcommand '$1'" >&2
      echo "  for a worker worktree: fleet w $1" >&2
      echo "  (bare 'fleet' launches the coordinator in the hub; see fleet -h)" >&2
      exit 2 ;;
  esac
fi

# `global` (per-user instructions) and `feedback` (the machine-wide seen ledger,
# spanning every project) are machine-wide, not per-project — like `init`, they
# resolve no project. `route` resolves project config if available, but falls back
# gracefully to global routing preferences without failing if no project is active.
if [ "$sub" != global ] && [ "$sub" != feedback ]; then
  if [ "$sub" = route ]; then
    fleet_resolve_conf "$proj" 2>/dev/null || true
    [ -n "${CONF:-}" ] && export FLEET_CONF
  else
    fleet_resolve_conf "$proj"
    export FLEET_CONF   # so new-worker reuses the exact same project config
    PROJ_NAME="$(basename "$CONF" .env)"
    fleet_export_worker_env   # HUB/GUARD/NOTIFY/NTFY_TOPIC, read by pack_worker_setup (refresh path)
  fi
fi

# ---------- shared helpers ----------

# Run one pack function in a subshell (so several packs' definitions never
# collide): pack_in <pack> <fn> [args...]
pack_in() { ( fleet_load_pack "$1" && shift && "$@" ); }

need_code_repo() {
  MAIN="${CODE_REPO:?set CODE_REPO in $CONF}"
  WT_HOME="${WT_HOME:?set WT_HOME in $CONF}"
}

need_agent() {
  agent="${agent:-$(fleet_default_agent)}"
  fleet_agent_enabled "$agent" || {
    echo "error: agent '$agent' is not enabled for this project (AGENTS=\"$(fleet_agents)\" in $CONF)" >&2
    exit 2
  }
}

launch() {  # launch the selected agent in the cwd (never returns)
  fleet_load_pack "$agent"
  pack_launch "${1:-}"
}

open_in() {  # cd somewhere, offer resume, launch (never returns)
  local dest="$1"
  cd "$dest"
  if pack_in "$agent" pack_has_sessions "$dest"; then
    # Three-way: continue-last (default) / CLI session picker / fresh.
    # Packs map --continue and --pick; those without a picker fall back to continue.
    read -rp "  (c)ontinue last $agent session, (r)esume picker, or (n)ew? [C/r/n] " ans
    case "${ans:-c}" in
      n|N) launch ;;
      r|R) launch --pick ;;
      *)   launch --continue ;;
    esac
  fi
  launch
}

sessions_label() {  # per-pack session markers for a worktree, e.g. "[claude sessions] "
  local dir="$1" a out=""
  for a in $(fleet_agents); do
    pack_in "$a" pack_has_sessions "$dir" && out="${out}[$a sessions] "
  done
  printf '%s' "$out"
}

worktree_paths() {  # every worktree under WT_HOME
  git -C "$MAIN" worktree list --porcelain | sed -n 's/^worktree //p' \
    | while IFS= read -r p; do case "$p" in "$WT_HOME"/*) echo "$p";; esac; done
}

# Dirty state that MATTERS: ignore the untracked per-pack barrier configs the
# fleet itself wrote (they would otherwise mark every worker of a hub project
# as uncommitted forever, and prune/del would never fire). The ignore list is
# built from every available pack's pack_barrier_files declaration — ALL packs
# on disk, not just enabled ones, so a pack disabled later still matches.
barrier_ignore_regex() {
  local d a f pats=""
  # Core fleet sidecars (dispatch/write-probe) — always ignore for del/prune even
  # when the enabled pack did not declare them (MAT-23).
  pats="\\.dispatch-marker\$|\\.model-marker\$|\\.fleet-witness\$"
  for d in "$FLEET_PACKS_DIR"/*/; do
    a="$(basename "$d")"
    [ -f "$FLEET_PACKS_DIR/$a/pack.sh" ] || continue
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      pats="${pats}|${f//./\\.}\$"
    done < <(pack_in "$a" pack_barrier_files 2>/dev/null || true)
  done
  printf '%s' "$pats"
}

# real_dirty runs inside command substitutions (subshells), so its lazy
# memoization of BARRIER_IGNORE cannot persist — callers that loop over
# worktrees (ls, prune) prime it once in the parent shell instead.
prime_barrier_ignore() { BARRIER_IGNORE="${BARRIER_IGNORE-$(barrier_ignore_regex)}"; }

real_dirty() {
  # -uall: expand untracked dirs to individual files. Without it git collapses
  # e.g. ".claude/settings.local.json" + a REAL user file to one "?? .claude/"
  # line, and filtering that line would hide the real work from del/prune.
  if [ -z "${BARRIER_IGNORE+x}" ]; then BARRIER_IGNORE="$(barrier_ignore_regex)"; fi
  if [ -n "$BARRIER_IGNORE" ]; then
    GIT_OPTIONAL_LOCKS=0 git -C "$1" status --porcelain -uall 2>/dev/null \
      | grep -vE "^\?\? ($BARRIER_IGNORE)" || true
  else
    GIT_OPTIONAL_LOCKS=0 git -C "$1" status --porcelain -uall 2>/dev/null || true
  fi
}

# ---------- roles ----------

cmd_hub() {
  need_agent
  # Not yet in a tmux window: pick the machine and (re)open the `hub` window
  # there, then attach. session_window never returns. A local target with no hub
  # is caught early; a remote target's hub is validated inside its container.
  # in_target_window: `fleet` typed in the hub window's own fallback shell (agent
  # died) relaunches in place instead of a no-op select (see in_target_window).
  if [ -z "${FLEET_IN_WINDOW:-}" ] && ! in_target_window hub; then
    target_machine
    if [ "$M_LOCAL" = 1 ] && { [ -z "$HUB" ] || [ ! -d "$HUB" ]; }; then
      echo "error: project '$PROJ_NAME' has no docs hub (HUB unset in $CONF)." >&2
      echo "  There is no coordinator to launch; for a worker: fleet w <name>" >&2
      exit 2
    fi
    session_window hub hub
  fi
  # Inside the window (on the machine where the hub lives): the real launch.
  if [ -z "$HUB" ] || [ ! -d "$HUB" ]; then
    echo "error: no docs hub here (HUB unset/missing in $CONF)." >&2; exit 2
  fi
  # Stamp this coordinator so workers it dispatches record their parent (WS3).
  export FLEET_COORDINATOR="${FLEET_MACHINE:-local}:$PROJ_NAME:hub"
  # Per-user global instructions for a CLI with no native global file (cursor):
  # inject the canonical into the hub as a project rule before launching, so the
  # coordinator session gets them too (workers get it via pack_worker_setup).
  ( fleet_load_pack "$agent" >/dev/null 2>&1 \
    && declare -F pack_global_inject >/dev/null && pack_global_inject "$HUB" ) || true
  echo "[fleet] coordinator on hub: $HUB (agent: $agent, machine: ${FLEET_MACHINE:-local})"
  open_in "$HUB"
}

cmd_worker() {
  local name="${1:-}" base="${2:-}"
  [ -z "$name" ] && { echo "usage: fleet w <name> [base]" >&2; exit 2; }
  fleet_valid_name "$name" "worker name" || exit 2
  need_agent
  # Not yet in a tmux window: pick the machine and (re)open the worker window
  # there, then attach. The worktree itself is created inside that window, on the
  # machine where it lives (so a remote-only project needs no local clone).
  # in_target_window: `fleet w <name>` typed in that worker's own fallback shell
  # (agent died) relaunches in place instead of a no-op select.
  if [ -z "${FLEET_IN_WINDOW:-}" ] && ! in_target_window "$name"; then
    target_machine
    # Admission is probe-then-create (S4): fleet_guard only checks the count;
    # session_window (below) is what actually creates the tmux window future
    # probes will see. Hold the admission lock across both, so two
    # near-simultaneous `fleet w` calls can't both read the same pre-create
    # count and both pass. session_window releases it right after the window
    # exists, before attaching the view — never held through an interactive
    # attach (see fleet_guard_unlock there and in fleet-config.sh).
    fleet_guard_lock || exit 2
    fleet_guard || exit 2   # refuse if this machine is at its worker/RAM/disk limit
    session_window "$name" w "$name" ${base:+$base}
  fi
  # Inside the window: real work on this machine.
  need_code_repo
  local dest="$WT_HOME/$name"
  if [ ! -d "$dest" ]; then
    [ -z "$base" ] && base="$(pick_base "$name")"
    "$NEW_WORKER" "$name" "$base"
    write_worker_meta "$name" interactive
    cd "$dest"; launch
  fi
  echo "[fleet] worktree $dest already exists."
  open_in "$dest"
}

pick_base() {
  local name="$1" default="${DEFAULT_BASE:-origin/main}"
  git -C "$MAIN" fetch origin --quiet 2>/dev/null || true
  local refs=()
  mapfile -t refs < <(
    git -C "$MAIN" for-each-ref --sort=-committerdate \
      --format='%(refname:short)%09%(committerdate:relative)%09%(contents:subject)' \
      refs/heads refs/remotes/origin 2>/dev/null \
      | awk -F'\t' '$1!="origin" && $1!="origin/HEAD" && !seen[$1]++' | head -n 20
  )
  if [ "${#refs[@]}" -eq 0 ]; then echo "$default"; return; fi
  # MAT-19: never block scripts/cron on an interactive menu.
  # - non-TTY stdin → DEFAULT_BASE
  # - exactly one candidate → that ref
  if [ ! -t 0 ]; then echo "$default"; return; fi
  if [ "${#refs[@]}" -eq 1 ]; then
    IFS=$'\t' read -r rname _ <<<"${refs[0]}"; echo "$rname"; return
  fi
  {
    echo "Base branch for new worker '$name' (most recent on top):"
    local i=1 line rname rdate rsubj
    for line in "${refs[@]}"; do
      IFS=$'\t' read -r rname rdate rsubj <<<"$line"
      printf '  %2d) %-38s %-14s %s\n' "$i" "$rname" "$rdate" "$rsubj"
      i=$((i+1))
    done
    printf '  [Enter = %s]  choice (number or branch name): ' "$default"
  } >&2
  local ans; read -r ans || true
  if [ -z "$ans" ]; then echo "$default"; return; fi
  if [[ "$ans" =~ ^[0-9]+$ ]] && [ "$ans" -ge 1 ] && [ "$ans" -le "${#refs[@]}" ]; then
    IFS=$'\t' read -r rname _ <<<"${refs[$((ans-1))]}"; echo "$rname"; return
  fi
  echo "$ans"
}

# ---------- machines / sessions ----------

# Resolve the operation's target machine into M_* (fleet_load_machine). Honors
# --machine, then $FLEET_MACHINE (set inside a window), else the given default
# (usually "local"). Legacy --host retargets the ssh host for this one call.
target_machine() {  # [default-name]
  local name="${machine:-${FLEET_MACHINE:-${1:-local}}}"
  if [ -n "$host" ]; then
    # Legacy --host: retarget the ssh host for this one call. Keep a named
    # machine's container/tmux if it resolves; otherwise use the REMOTE_* defaults.
    if ! fleet_load_machine "$name" 2>/dev/null || [ "$M_LOCAL" = 1 ]; then
      M_NAME="$name" M_CONTAINER="${REMOTE_CONTAINER:-fleet}" M_TMUX="${REMOTE_TMUX:-fleet}"
      M_ENGINE="${REMOTE_ENGINE_DIR:-agent-fleet}" M_PROJECT="${REMOTE_PROJECT:-$PROJ_NAME}"
    fi
    M_HOST="$host"; M_LOCAL=0
    return 0
  fi
  fleet_load_machine "$name" || exit 2
}

# The fleet command that runs INSIDE a tmux window on the target machine. Local
# windows pin the resolved env (same box, correct paths); a remote window runs
# in the container, which resolves its own config, so only --project is passed.
# FLEET_IN_WINDOW=1 tells the inner fleet to do the real launch, not re-wrap.
#
# The context vars are EXPORTED into the shell (not `env`-scoped to the inner
# fleet), so the fallback shell left behind when the agent exits ("<cmd>; exec
# bash") carries them too: an operator who then types `fleet` in that dead
# window resolves the SAME project/machine and relaunches this role in place
# (via in_target_window in cmd_hub/cmd_worker). Three deliberate choices:
# (1) `unset FLEET_CONF` first: a fleet tmux SERVER holds FLEET_CONF in its
#     global environment, so every window it spawns inherits the SERVER's
#     project. An explicit --project already wins over that inheritance, but a
#     bare `fleet` in the fallback shell would still honour the inherited
#     FLEET_CONF — clearing it lets FLEET_PROJECT (below) be the soft default.
# (2) export FLEET_PROJECT, not FLEET_CONF: the fallback shell resolves this
#     window's project by default, yet a later `fleet --project X` typed there
#     still wins (--project beats both FLEET_PROJECT and any re-exported conf).
# (3) FLEET_IN_WINDOW stays command-scoped, NOT exported — the in-place relaunch
#     decision is made by matching the current window (in_target_window), so
#     `fleet <other-role>` from a fallback shell still opens the other window.
window_cmd() {  # <fleet args...>
  if [ "$M_LOCAL" = 1 ]; then
    printf 'unset FLEET_CONF; export FLEET_HOME=%q FLEET_PACKS_DIR=%q FLEET_PROJECT=%q FLEET_MACHINE=%q; FLEET_IN_WINDOW=1 fleet --project %q%s %s' \
      "$FLEET_ROOT" "$FLEET_PACKS_DIR" "$M_PROJECT" "$M_NAME" "$M_PROJECT" "${agent:+ -a $agent}" "$*"
  else
    printf 'unset FLEET_CONF; export FLEET_PROJECT=%q; FLEET_IN_WINDOW=1 fleet --project %s%s %s' \
      "$M_PROJECT" "$M_PROJECT" "${agent:+ -a $agent}" "$*"
  fi
}

# True when we are already sitting in tmux window <win> (e.g. the fallback shell
# of a window whose agent exited). Lets cmd_hub/cmd_worker relaunch THIS role in
# place instead of no-op'ing: from the fallback shell the fleet we spawn is a
# child of the pane, so session_window's dead-detection reads the window as
# alive and skips the respawn, and view_snippet then just re-selects the window
# and exits — the operator is stuck at the shell. Matching a DIFFERENT role
# still routes through session_window (opens/selects that role's own window).
# Window-name match only: a rare false match just relaunches the same-named role
# in place, which is what the operator wanted anyway.
in_target_window() {  # <win>
  [ -n "${TMUX:-}" ] || return 1
  [ "$(tmux display-message -p '#{window_name}' 2>/dev/null)" = "$1" ]
}

# Interactive attach (local tmux switch-client/attach, remote ssh -t + docker
# exec -it) needs a controlling terminal. An agent's Bash tool has no tty (nor
# does a piped or redirected invocation), so tmux aborts with the cryptic
# "open terminal failed: not a terminal" and ssh with "Pseudo-terminal will not
# be allocated". Fail early with an actionable message instead. `fleet dispatch`
# is the headless path and never routes through here, so it stays unaffected.
tty_or_die() {
  [ -t 0 ] && return 0
  cat >&2 <<'EOF'
error: this is an interactive session command (it attaches a tmux terminal), but
  the current shell has no tty. An agent's Bash tool has none, and so does a
  piped or redirected invocation, so tmux would fail with "open terminal failed:
  not a terminal".
  - Headless / agent context: use  fleet dispatch <name> "<task>"  instead.
  - Interactive use: run this from your own terminal.
EOF
  return 1
}

# Emit a shell script that hands THIS terminal a private, grouped "view" of the
# machine session <sess>, focused on <win> (empty = whole session, any window).
# Why a view and not a direct attach: tmux shares one active window across every
# client of a session, so attaching a worker to $M_TMUX would yank a coordinator
# already viewing another window of it onto the worker's pane. A grouped session
# (`new-session -t`) shares the window LIST — new workers still appear — but keeps
# its own active window, so clients never drag each other. The view self-destructs
# when this client detaches (client-detached hook) and is named fv-* so the
# resource guard's `^fleet` window count never double-counts its shared windows.
# The same snippet runs local (bash -c) or remote (base64'd through ssh+docker);
# $$ and $TMUX resolve on whichever shell runs it. The machine session itself is
# thus never attached by a human — which is what makes the no-drag guarantee hold.
view_snippet() {  # <sess> <win-or-empty>
  local sess="$1" win="$2" sel=""
  [ -n "$win" ] && sel="tmux select-window -t \"\$V:$win\" 2>/dev/null || true"
  cat <<SNIP
if [ -n "\${TMUX:-}" ] && [ -n "$win" ] && tmux select-window -t "$win" 2>/dev/null; then exit 0; fi
V="fv-$sess-${win:-all}-\$\$"
tmux kill-session -t "\$V" 2>/dev/null || true
tmux new-session -d -t "$sess" -s "\$V"
$sel
tmux set-hook -t "\$V" client-detached "kill-session -t \$V"
if [ -n "\${TMUX:-}" ]; then exec tmux switch-client -t "\$V"; else exec tmux attach -t "\$V"; fi
SNIP
}

# Emit a shell script that ensures window <win> of session <sess> exists AND is
# running its agent (same transport story as view_snippet: bash -c locally,
# base64 through ssh+docker remotely). Creating a missing window is the easy
# half. The subtle half is a window whose agent DIED: every window is launched
# as "<cmd>; exec bash", so when the agent exits the window survives as a bare
# fallback shell — a plain select would silently focus that dead session and the
# operator ends up relaunching the CLI by hand, outside the fleet posture (auto
# mode, barrier, MCP profile). Instead, detect the dead pane and respawn the
# ORIGINAL launch line into it: it re-enters the in-window fleet, so the
# operator gets the same resume offer as on first creation — a dead window is
# indistinguishable from a fresh one.
# Dead-detection (verified empirically, tmux 3.4): #{pane_current_command} is
# NOT enough — the "<cmd>; exec bash" wrapper does no job control, so an ALIVE
# window also reports a shell. The discriminator is children of #{pane_pid}: an
# alive pane has the agent (or the in-window fleet at its resume prompt, or a
# command the operator ran in the fallback shell) as a child; a dead pane is a
# childless shell. No ps on the box → cannot tell → leave the pane alone (old
# select behavior, never kill something we cannot prove dead).
ensure_window_snippet() {  # <sess> <win> <inner-cmd>
  local sess="$1" win="$2" wcmd
  wcmd="$(printf '%q' "$3; exec bash")"
  cat <<SNIP
tmux has-session -t "$sess" 2>/dev/null || tmux new-session -d -s "$sess" -n _home
if tmux list-windows -t "$sess" -F '#{window_name}' 2>/dev/null | grep -Fxq -- "$win"; then
  info="\$(tmux display-message -p -t "$sess:$win" '#{pane_pid} #{pane_current_command}' 2>/dev/null || true)"
  pid="\${info%% *}"; cmd="\${info##* }"
  case "\$cmd" in
    bash|sh|dash|ash|zsh|ksh|fish)
      if [ -n "\$pid" ] && command -v ps >/dev/null 2>&1 \
         && ! ps -o pid= --ppid "\$pid" 2>/dev/null | grep -q .; then
        echo "[fleet] window '$win': agent process died — relaunching"
        tmux respawn-pane -k -t "$sess:$win" $wcmd
      fi ;;
  esac
  tmux select-window -t "$sess:$win" 2>/dev/null || true
else
  tmux new-window -d -t "$sess" -n "$win" $wcmd
fi
SNIP
}

# Open (or reuse) window <win> on the target machine running the given fleet
# subcommand, then attach through a private view. Local = plain tmux; remote =
# ssh + docker exec tmux (both snippets are base64'd so their quotes survive the
# ssh+docker nesting, same transport as guard_probe). A window whose agent died
# is relaunched by ensure_window_snippet before the view attaches.
session_window() {  # <win> <fleet args...>
  local win="$1"; shift
  local inner; inner="$(window_cmd "$@")"
  local ensure; ensure="$(ensure_window_snippet "$M_TMUX" "$win" "$inner")"
  if [ "$M_LOCAL" = 1 ]; then
    command -v tmux >/dev/null || { echo "error: tmux not installed (needed for sessions)" >&2; exit 2; }
    bash -c "$ensure"
    # Window exists now (created or reused) — release the admission lock (S4;
    # see fleet_guard_lock/fleet_guard_unlock in fleet-config.sh) if cmd_worker
    # took one. A no-op when nothing is held (cmd_hub/cmd_remote call
    # session_window without ever locking). This MUST happen before the view
    # attach below, which can block for as long as the operator stays
    # attached — the lock must never live that long.
    fleet_guard_unlock
    # No tty check here on purpose: this local branch must create/relaunch the
    # window as a side effect BEFORE the attach (test/relaunch.sh drives it in a
    # no-tty harness and depends on that). With no tty the final view attach
    # still fails as tmux "open terminal failed"; the clean-message guard covers
    # the interactive-only entry points (session_attach, and the remote branch
    # below) where nothing is created first.
    local snip; snip="$(view_snippet "$M_TMUX" "$win")"
    exec bash -c "$snip"
  else
    version_preflight   # non-fatal warning if the VM engine lags the local one
    local b64e b64v
    b64e="$(printf '%s' "$ensure" | base64 | tr -d '\n')"
    b64v="$(view_snippet "$M_TMUX" "$win" | base64 | tr -d '\n')"
    # Same release as the local branch above, but ensure+view run together in
    # one ssh call here, so we can't unlock strictly between window-creation
    # and attach — release before issuing it. This narrows (does not fully
    # close) the S4 window for `fleet w` against a REMOTE machine; `fleet
    # dispatch` (cmd_dispatch) closes it fully there because it recurses into
    # the remote box's own `fleet` process, which takes ITS OWN lock.
    fleet_guard_unlock
    # ensure+view both run remotely inside this one ssh -t; with no local tty,
    # ssh can't allocate a PTY and remote tmux dies "open terminal failed: not a
    # terminal". Fail here with the actionable message (nothing created yet).
    tty_or_die || exit 2
    exec ssh -t "$M_HOST" "docker exec -it $M_CONTAINER bash -lc 'echo $b64e | base64 -d | bash; echo $b64v | base64 -d | bash'"
  fi
}

# Attach the target machine's whole tmux session (all its windows), through a
# private view so two attaches never drag each other's active window.
# One-line usage reminder before the attach (tty only: tty_or_die has already
# guaranteed one). With $TMUX set the view snippet does `switch-client` (this
# client is moved to the view, nothing is nested), so the prefix is unchanged;
# only the way back differs.
attach_hint() {
  [ -t 2 ] || return 0
  echo "[fleet] Ctrl-b w: list windows | Ctrl-b n/p: next/previous | Ctrl-b d: detach" >&2
  if [ -n "${TMUX:-}" ]; then
    echo "[fleet] already inside tmux: this client is switched to the fleet view; Ctrl-b s lists sessions to go back." >&2
  fi
}

session_attach() {
  tty_or_die || exit 2
  attach_hint
  if [ "$M_LOCAL" = 1 ]; then
    command -v tmux >/dev/null || { echo "error: tmux not installed" >&2; exit 2; }
    tmux has-session -t "$M_TMUX" 2>/dev/null \
      || { echo "no session '$M_TMUX' yet on '$M_NAME' (launch: fleet, or fleet w <name>)" >&2; exit 1; }
    local snip; snip="$(view_snippet "$M_TMUX" "")"
    exec bash -c "$snip"
  else
    local b64; b64="$(view_snippet "$M_TMUX" "" | base64 | tr -d '\n')"
    exec ssh -t "$M_HOST" "docker exec -it $M_CONTAINER bash -lc 'tmux has-session -t $M_TMUX 2>/dev/null || tmux new-session -d -s $M_TMUX -n _home; echo $b64 | base64 -d | bash'"
  fi
}

# `fleet r` — shorthand for the project's remote machine (first non-local, or a
# legacy REMOTE_HOST synthesized as "remote"). --machine overrides the pick.
cmd_remote() {
  local rm; rm="${machine:-$(fleet_remote_machine || true)}"
  [ -z "$rm" ] && [ -n "$host" ] && rm=remote   # legacy `fleet --host vm r`
  [ -n "$rm" ] || {
    echo "error: this project has no remote machine (add one to MACHINES or set" >&2
    echo "  REMOTE_HOST in $CONF, or pass --machine <name> / --host <vm>)." >&2
    exit 2
  }
  machine="$rm"; target_machine
  case "${1:-}" in
    "")  session_attach ;;
    hub) need_agent; session_window hub hub ;;
    w|worker)
      local name="${2:-}" base="${3:-}"
      [ -z "$name" ] && { echo "usage: fleet r w <name> [base]" >&2; exit 2; }
      fleet_valid_name "$name" "worker name" || exit 2   # threads through tmux/ssh unquoted
      need_agent; session_window "$name" w "$name" ${base:+$base} ;;
    del)
      local name="${2:-}"
      [ -z "$name" ] && { echo "usage: fleet r del <name>" >&2; exit 2; }
      fleet_valid_name "$name" "worker name" || exit 2   # threads through tmux/ssh unquoted
      [ "$M_LOCAL" = 1 ] && { echo "error: 'r del' targets a remote machine" >&2; exit 2; }
      ssh "$M_HOST" "docker exec $M_CONTAINER tmux kill-window -t $M_TMUX:$name 2>/dev/null; docker exec $M_CONTAINER bash -lc 'fleet --project $M_PROJECT del $name'" ;;
    broadcast)
      shift
      local text="$*"
      [ -z "$text" ] && { echo "usage: fleet r broadcast \"<message>\"" >&2; exit 2; }
      [ "$M_LOCAL" = 1 ] && { echo "error: broadcast targets a remote machine" >&2; exit 2; }
      # Send the message to EVERY window of the remote tmux (uzi's broadcast
      # pattern): "commit and stop", "rebase on main", ... The text rides as
      # base64 (decoded into $txt on the remote), so quotes/`$`/backticks in it
      # are never re-evaluated by the remote shell — no injection, any text goes.
      local b64; b64="$(printf '%s' "$text" | base64 | tr -d '\n')"
      ssh "$M_HOST" "docker exec $M_CONTAINER bash -lc 'txt=\$(printf %s $b64 | base64 -d); for w in \$(tmux list-windows -t $M_TMUX -F \"#{window_index}:#{window_name}\" 2>/dev/null); do tmux send-keys -t $M_TMUX:\${w%%:*} \"\$txt\" Enter && echo \"sent to \$w\"; done'" ;;
    *)
      echo "error: unknown remote subcommand '${1}'" >&2
      echo "  fleet r                    attach the machine's tmux" >&2
      echo "  fleet r w <name>           remote worker    fleet r hub   remote coordinator" >&2
      echo "  fleet r del <name>         delete a remote worker" >&2
      echo "  fleet r broadcast \"<msg>\"  type <msg>+Enter in every remote window" >&2
      exit 2 ;;
  esac
}

# ---------- management ----------

cmd_ls() {
  need_code_repo
  # Per-invocation cache dir: packs whose pack_has_sessions shells out to a
  # slow CLI (e.g. a full session list) may memoize in here across worktrees.
  FLEET_CACHE_DIR="$(mktemp -d)"; export FLEET_CACHE_DIR
  trap 'rm -rf "$FLEET_CACHE_DIR"' EXIT
  prime_barrier_ignore
  # Always the local CODE_REPO worktrees — even with --machine M. Remote live
  # sessions live in that machine's tmux; use `fleet status --remote` / `peek`.
  echo "worktrees [$PROJ_NAME] (local CODE_REPO) — 'fleet w NAME' to (re)open, bare 'fleet' for the coordinator:"
  echo "  (remote sessions: fleet status --remote / fleet peek <machine> <win>)"
  local m
  for m in $(fleet_machines); do
    if fleet_load_machine "$m" 2>/dev/null; then
      if [ "$M_LOCAL" = 1 ]; then
        printf '  machine: %-10s local (tmux %s) — fleet / fleet w <name>\n' "$m" "$M_TMUX"
      else
        printf '  machine: %-10s %s (container %s, tmux %s) — fleet --machine %s ...  (fleet r)\n' \
          "$m" "$M_HOST" "$M_CONTAINER" "$M_TMUX" "$m"
      fi
    else
      printf '  machine: %-10s (unresolved — see fleet machines)\n' "$m"
    fi
  done
  printf '  %-18s %-26s %-9s %s\n' "NAME" "BRANCH" "SHA" "STATE / PATH"
  local path="" head="" branch=""
  while IFS= read -r line; do
    case "$line" in
      "worktree "*) path="${line#worktree }" ;;
      "HEAD "*)     head="${line#HEAD }" ;;
      "branch "*)   branch="${line#branch refs/heads/}" ;;
      "detached")   branch="(detached)" ;;
      "")
        [ -z "$path" ] && continue
        local name state
        if [ "$path" = "$MAIN" ]; then name="(base repo)"
        elif [ "${path#$WT_HOME/}" != "$path" ]; then name="${path#$WT_HOME/}"
        else name="$(basename "$path")"; fi
        state=""
        if [ "$path" != "$MAIN" ]; then
          [ -n "$(real_dirty "$path")" ] && state="[UNCOMMITTED] "
          state="${state}$(sessions_label "$path")"
          state="${state}$(dispatch_status_label "$name" "$path")"
        fi
        printf '  %-18s %-26s %-9s %s%s\n' "$name" "${branch:-?}" "${head:0:7}" "$state" "$path"
        path=""; head=""; branch=""
        ;;
    esac
  done < <(git -C "$MAIN" worktree list --porcelain; echo)
  # Orphan tmux windows (no worktree / deleted pane path) are invisible to the
  # worktree list above — surface them so operators do not need a manual
  # `tmux list-windows` (MAT-122).
  report_orphan_windows
}

cmd_del() {
  local name="${1:-}"
  [ -z "$name" ] && { echo "usage: fleet del <name>" >&2; exit 2; }
  need_code_repo
  local dest="$WT_HOME/$name"
  # Worktree already gone: still reap leftover tmux / dispatch state so a prior
  # incomplete cleanup (or del against a name whose tree was removed outside
  # fleet) does not leave `_done-<name>` panes accumulating in the session.
  if [ ! -d "$dest" ]; then
    if worker_runtime_exists "$name"; then
      reap_worker_state "$name"
      echo "[fleet] no worktree at $dest — reaped leftover window/state for '$name'"
      return 0
    fi
    echo "error: worktree $dest not found" >&2; exit 1
  fi
  local dirty; dirty="$(real_dirty "$dest")"
  if [ -n "$dirty" ]; then
    echo "REFUSED: $dest has uncommitted changes:" >&2
    echo "$dirty" >&2
    echo "Commit/merge (or explicitly discard) before deleting." >&2
    exit 1
  fi
  git -C "$MAIN" worktree remove --force "$dest"   # --force: only fleet-written barrier files remain
  reap_worker_state "$name"   # kill the lingering tmux window + GC dispatch sidecars
  echo "[fleet] worktree removed: $dest"
  if git -C "$MAIN" branch -d "$name" 2>/dev/null; then
    echo "[fleet] branch removed: $name (merged)"
  else
    echo "[fleet] branch '$name' KEPT: unmerged commits." >&2
    echo "  To force: git -C $MAIN branch -D $name" >&2
  fi
}

cmd_prune() {
  need_code_repo
  local do_windows=0
  while :; do
    case "${1:-}" in
      --windows) do_windows=1; shift ;;
      -*) echo "error: unknown prune flag '$1' (want --windows)" >&2; exit 2 ;;
      *) break ;;
    esac
  done
  local base="${DEFAULT_BASE:-origin/main}"
  git -C "$MAIN" fetch origin --quiet 2>/dev/null || true
  prime_barrier_ignore
  local pruned=0 kept=0 p name branch paths=()
  mapfile -t paths < <(worktree_paths)
  for p in "${paths[@]}"; do
    name="$(basename "$p")"
    branch="$(git -C "$p" rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?')"
    if [ -n "$(real_dirty "$p")" ]; then
      echo "  keep  $name (uncommitted changes)"; kept=$((kept+1)); continue
    fi
    if ! git -C "$MAIN" merge-base --is-ancestor "$(git -C "$p" rev-parse HEAD)" "$base" 2>/dev/null; then
      echo "  keep  $name (branch '$branch' not merged into $base)"; kept=$((kept+1)); continue
    fi
    git -C "$MAIN" worktree remove --force "$p"   # --force: only fleet-written barrier files remain
    reap_worker_state "$name"   # kill the lingering tmux window + GC dispatch sidecars
    git -C "$MAIN" branch -d "$name" 2>/dev/null || true
    echo "  prune $name (merged into $base)"; pruned=$((pruned+1))
  done
  echo "[fleet] prune: $pruned removed, $kept kept."
  # Idle finished-dispatch panes (`_done-*`) whose worktree is already gone are
  # safe to reap without --windows / --force: no agent child, nothing to inspect
  # against a missing tree. Other orphans (ad-hoc panes, live agents) stay
  # report-only unless `prune --windows` (+ `--force` for live).
  reap_idle_done_orphans
  if [ "$do_windows" = 1 ]; then
    prune_orphan_windows
  else
    report_orphan_windows
  fi
}

cmd_refresh() {
  need_code_repo
  local targets=() a p
  if [ -n "${1:-}" ]; then
    [ -d "$WT_HOME/$1" ] || { echo "error: worktree $WT_HOME/$1 not found" >&2; exit 1; }
    targets=("$WT_HOME/$1")
  else
    mapfile -t targets < <(worktree_paths)
  fi
  [ "${#targets[@]}" -eq 0 ] && { echo "[fleet] refresh: no worktrees."; return; }
  for p in "${targets[@]}"; do
    for a in $(fleet_agents); do
      fleet_setup_worktree "$a" "$p" \
        || { echo "error: pack '$a' setup failed on $p (see above)" >&2; exit 1; }
    done
    echo "  refreshed $(basename "$p") (packs: $(fleet_agents))"
  done
}

cmd_add_agent() {
  local pack="${1:-}"
  [ -z "$pack" ] && { echo "usage: fleet add-agent <pack>" >&2; exit 2; }
  [ -f "$FLEET_PACKS_DIR/$pack/pack.sh" ] || {
    echo "error: unknown pack '$pack'; available:" >&2
    # Only real packs (dirs with pack.sh) — never loose helpers like hub-mount-ns.sh.
    for d in "$FLEET_PACKS_DIR"/*/pack.sh; do
      [ -f "$d" ] || continue
      printf '  %s\n' "$(basename "$(dirname "$d")")" >&2
    done
    exit 2
  }
  if fleet_agent_enabled "$pack"; then
    echo "[fleet] '$pack' already enabled (AGENTS=\"$(fleet_agents)\")."
  else
    local new_agents; new_agents="$(fleet_agents) $pack"
    if grep -q '^AGENTS=' "$CONF"; then
      # Escape sed replacement metachars (\ & and the | delimiter) so a pack name
      # with such a char can't corrupt the substitution.
      local esc="${new_agents//\\/\\\\}"; esc="${esc//&/\\&}"; esc="${esc//|/\\|}"
      sed -i "s|^AGENTS=.*|AGENTS=\"$esc\"|" "$CONF"
    else
      printf 'AGENTS="%s"\n' "$new_agents" >> "$CONF"
    fi
    # shellcheck disable=SC2034  # keep the in-memory AGENTS in sync with the .env just written
    AGENTS="$new_agents"
    echo "[fleet] AGENTS=\"$new_agents\" written to $CONF"
  fi
  if [ -n "${CODE_REPO:-}" ] && [ -n "${WT_HOME:-}" ]; then
    cmd_refresh
  fi
}

# fleet gate: run the project's declared pre-PR checks (GATE_CMDS in the .env,
# one shell command per line). The fleet bundles no linter and knows no tool:
# auto-fixing lives inside the commands the project declares (e.g. a lint
# command with its --fix flag), so fixable noise is repaired mechanically with
# zero model tokens, and only what still fails is printed — the residual a
# model actually has to think about (docs/06). No GATE_CMDS = no-op, so the
# gate costs nothing to projects that never declare one.
cmd_gate() {
  local review="${GATE_REVIEW:-0}" args=() rc=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --review) review=1 ;;
      --scope)  [ $# -ge 2 ] || { echo "error: --scope needs a value" >&2; return 2; }
                args+=(--scope "$(python3 "$SELF_DIR/fleet_checks.py" norm-scope "$2")") || return 2; shift ;;
      *) args+=("$1") ;;
    esac
    shift
  done
  gate_checks "${args[@]}" || rc=$?
  # Advisory post-gate review: only after the deterministic checks pass,
  # never changes the exit code — a false positive must not silently block a PR.
  if [ "$rc" -eq 0 ] && [ "$review" = 1 ]; then
    cmd_judge || echo "gate: review pass unavailable (advisory — gate result unchanged)"
  fi
  return "$rc"
}

# Convention checks (bin/fleet_checks.py) share the gate's report: one line per
# finding as file:line, advisory (WARN, never fails) or blocking (BLOCK, counts
# as a failed check). Enabled by GATE_CHECKS / the worker's dispatch spec /
# --scope; none enabled = nothing runs.
gate_convention_checks() {  # <root> <scope> ; prints report, returns 1 on a blocking finding
  local root="$1" scope="$2" checks="${GATE_CHECKS:-}" name meta
  name="$(basename "$root")"
  local sdir; sdir="$(dispatch_state_dir 2>/dev/null || true)"
  meta="${sdir:+$sdir/$name.meta}"
  if [ -n "$meta" ] && [ -f "$meta" ]; then
    local m_checks m_scope
    m_checks="$(sed -n 's/^checks=//p' "$meta" | head -1)"
    m_scope="$(sed -n 's/^scope=//p' "$meta" | head -1)"
    checks="${checks:+$checks,}$m_checks"
    [ -n "$scope" ] || scope="$m_scope"
  fi
  [ -n "$scope" ] || scope="${GATE_SCOPE:-}"
  [ -n "$checks" ] || [ -n "$scope" ] || return 0
  local out crc=0 nfind
  out="$(python3 "$SELF_DIR/fleet_checks.py" run --root "$root" --base "${DEFAULT_BASE:-origin/main}" --checks "$checks" --scope "$scope" 2>&1)" || crc=$?
  if [ "$crc" -eq 2 ]; then
    echo "gate: FAIL  convention checks misconfigured: $out"
    return 1
  fi
  if [ -n "$out" ]; then
    nfind="$(printf '%s\n' "$out" | wc -l)"
    echo "gate: convention checks ($nfind finding(s); WARN = advisory, BLOCK = blocking)"
    printf '%s\n' "$out" | head -n 200
  else
    echo "gate: ok    convention checks"
  fi
  [ "$crc" -eq 0 ]
}

gate_checks() {
  local escalate=0 scope_flag=""
  while :; do
    case "${1:-}" in
      --escalate) escalate=1; shift ;;
      --scope) scope_flag="$2"; shift 2 ;;
      *) break ;;
    esac
  done
  # Run from the repo root when inside one, so path-relative checks cover the
  # whole tree regardless of the subdir the session invoked the gate from.
  local root; root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
  local has_conv=0
  if [ -n "${GATE_CHECKS:-}" ] || [ -n "$scope_flag" ] || [ -n "${GATE_SCOPE:-}" ]; then has_conv=1
  else
    local sd; sd="$(dispatch_state_dir 2>/dev/null || true)"
    [ -n "$sd" ] && grep -qE '^(scope|checks)=' "$sd/$(basename "$root").meta" 2>/dev/null && has_conv=1
  fi
  if [ -z "${GATE_CMDS:-}" ] && [ "$has_conv" = 0 ]; then
    echo "gate: no checks declared (GATE_CMDS unset in $(basename "$CONF")) — nothing to gate"
    return 0
  fi
  local before after; before="$(git -C "$root" status --porcelain 2>/dev/null || true)"
  local line total=0 failed=0 rc out nlines
  while IFS= read -r line; do
    line="${line#"${line%%[![:space:]]*}"}"
    case "$line" in ""|\#*) continue ;; esac
    total=$((total + 1))
    rc=0; out="$(cd "$root" && bash -c "$line" 2>&1)" || rc=$?
    if [ "$rc" -eq 0 ]; then
      echo "gate: ok    $line"
    else
      failed=$((failed + 1))
      echo "gate: FAIL  $line   (rc=$rc)"
      # Bounded escalation: the check's own findings (file:line), not a log dump.
      echo "$out" | head -n 200
      nlines="$(printf '%s\n' "$out" | wc -l)"
      [ "$nlines" -gt 200 ] && echo "gate: … output truncated ($nlines lines; re-run for the rest: $line)"
    fi
  done <<< "${GATE_CMDS:-}"
  if [ "$has_conv" = 1 ]; then
    total=$((total + 1))
    gate_convention_checks "$root" "$scope_flag" || failed=$((failed + 1))
  fi
  after="$(git -C "$root" status --porcelain 2>/dev/null || true)"
  [ "$before" != "$after" ] && echo "gate: note — checks modified files (auto-fixes); include them in your commit"
  if [ "$failed" -gt 0 ]; then
    echo "gate: FAIL — $failed/$total check(s) failed; fix the findings above and re-run 'fleet gate'"
    if [ "$escalate" = 1 ] || [ "${GATE_ESCALATE:-0}" = 1 ] || [ "${ROUTE_GATE_ESCALATE:-0}" = 1 ]; then
      local esc_target
      esc_target="$(python3 "$SELF_DIR/fleet-route.py" --escalate 2>/dev/null || true)"
      if [ -n "$esc_target" ]; then
        echo "gate: automatic escalation target -> $esc_target"
        local sdir; sdir="$(dispatch_state_dir 2>/dev/null || true)"
        local cur_name; cur_name="$(basename "$root")"
        if [ -n "$sdir" ] && [ -d "$sdir" ]; then
          printf '%s %s gate-escalate %s\n' "$(date -u +%FT%TZ 2>/dev/null)" "$cur_name" "$esc_target" >> "$sdir/events.log"
          rotate_events_log "$sdir/events.log"
        fi
      fi
    fi
    return 1
  fi
  echo "gate: PASS — $total/$total check(s) passed"
}

cmd_agents() {
  echo "project : $PROJ_NAME"
  local a first=1
  for a in $(fleet_agents); do
    if [ "$first" = 1 ]; then echo "  $a (default)"; first=0; else echo "  $a"; fi
  done
  echo "(fleet doctor for install/login status; fleet add-agent <pack> to enable one)"
}

# fleet chats [<worker>]: per enabled pack, a READABLE pointer to the conversation
# that pack recorded for the agent that ran in the worker's worktree (or, bare, in
# the hub for the coordinator). For a cross-agent reprise: sessions are NOT
# portable between CLIs, so when you switch agents (or one dies), point the new
# agent at a pointer to READ the prior transcript — the durable handoff is still
# the hub, this is the fallback for what never got written there.
cmd_chats() {
  # fleet chats --scan [--project P|--all] [--json]: fleet-wide inventory of the
  # conversations every pack recorded (hub + all worktrees, all projects) — the
  # input the conversation-feedback routine reads. Delegates to the read-only
  # Python scanner (local machine only; transcripts are local/private).
  if [ "${1:-}" = --scan ]; then
    shift
    exec python3 "$SELF_DIR/fleet-chats-scan.py" "$@"
  fi
  local name="${1:-}" dir
  if [ -n "$name" ]; then
    need_code_repo; dir="$WT_HOME/$name"
    [ -d "$dir" ] || { echo "error: no worktree $dir" >&2; exit 1; }
  else
    dir="${HUB:-}"
    [ -n "$dir" ] || { echo "usage: fleet chats <worker>   (the bare form needs a hub, for the coordinator)" >&2; exit 2; }
  fi
  echo "recorded conversations for $dir"
  echo "  (read one to reprise a dead/other session; transcripts are NOT CLI-portable — read, do not resume):"
  local a p
  for a in $(fleet_agents); do
    p="$( ( fleet_load_pack "$a" >/dev/null 2>&1 \
            && declare -F pack_chat_pointer >/dev/null \
            && pack_chat_pointer "$dir" ) 2>/dev/null || true )"
    printf '  %-12s %s\n' "$a" "${p:-(none found)}"
  done
}

cmd_doctor() {
  if [ "${1:-}" = --write-probe ]; then
    shift
    # Accept `--machine M` AFTER the subcommand too: the global flag parser stops at
    # the subcommand token, so `fleet doctor --write-probe --machine M` would
    # otherwise drop --machine and probe local. Feed it into $machine (target_machine
    # reads it), so both flag orders reach the intended box.
    case "${1:-}" in
      --machine) [ $# -ge 2 ] || { echo "error: --machine needs a value" >&2; exit 2; }; machine="$2"; shift 2 ;;
    esac
    target_machine local
    doctor_write_probe
    return
  fi
  local a
  echo "packs enabled for '$PROJ_NAME':"
  for a in $(fleet_agents); do
    printf '  %-12s ' "$a"
    ( fleet_load_pack "$a" >/dev/null 2>&1   # exits the subshell on a broken pack — caught below
      if declare -F pack_doctor >/dev/null; then pack_doctor
      else echo "ok (no doctor implemented)"; fi
    ) || echo "PACK BROKEN or pack_doctor errored"   # one broken pack/CLI must not abort the report
  done
  local canon; canon="$(global_canon)"
  if [ -e "$canon" ]; then echo "global instructions: $canon (fleet global to re-wire, fleet global status to check)"
  else echo "global instructions: none yet — run 'fleet global' to install one file for every CLI"; fi
}

# fleet doctor --write-probe [--machine M]: prove the box can actually WRITE in
# --permission-mode auto, on demand. Catches the silent fail-open (org disables
# bypass -> every write auto-denied, agent exits rc=0 having written nothing) that
# a plain doctor misses. Runs one tiny headless turn per pack in a throwaway dir.
# Costs a few tokens, so it is opt-in, never part of a bare `fleet doctor`.
doctor_write_probe() {
  if [ "$M_LOCAL" = 1 ]; then
    echo "write-probe on '$M_NAME' (local):"
    local a d; d="$(mktemp -d "${TMPDIR:-/tmp}/fleet-probe.XXXXXX")"
    for a in $(fleet_agents); do
      printf '  %-12s ' "$a"
      ( fleet_load_pack "$a" >/dev/null 2>&1
        if declare -F pack_doctor >/dev/null; then ( cd "$d" && pack_doctor probe )
        else echo "no probe implemented"; fi ) || echo "PACK BROKEN or probe errored"
    done
    rm -rf "$d"
  else
    version_preflight
    echo "write-probe on '$M_NAME' ($M_HOST:$M_CONTAINER):"
    # Reuse the local path inside the container: it resolves 'local' there.
    ssh "$M_HOST" "docker exec $M_CONTAINER bash -lc 'fleet --project $M_PROJECT doctor --write-probe'" \
      || echo "  remote probe failed (ssh/docker/login?)"
  fi
}

# Warn (non-fatal) if the target machine's baked engine lags the local one, so a
# stale VM does not silently run old dispatch/barrier code. Best-effort: any probe
# failure is silent and never blocks the real command. Skips local. Called by the
# work-spawning paths only (session_window remote, remote dispatch, remote probe),
# not by every `fleet r`/status, to avoid an extra ssh round-trip on read paths.
version_preflight() {
  [ "${M_LOCAL:-0}" = 1 ] && return 0
  local engine_dir local_sha remote_sha
  engine_dir="$(cd "$SELF_DIR/.." && pwd)"
  local_sha="$(git -C "$engine_dir" rev-parse --short HEAD 2>/dev/null)" || return 0
  [ -n "$local_sha" ] || return 0
  remote_sha="$(ssh "$M_HOST" "docker exec $M_CONTAINER cat /opt/agent-fleet/.engine-sha 2>/dev/null" 2>/dev/null | tr -d '[:space:]')" || return 0
  [ -n "$remote_sha" ] && [ "$remote_sha" != unknown ] || return 0
  if [ "$remote_sha" != "$local_sha" ]; then
    echo "[fleet] WARNING: machine '$M_NAME' runs engine $remote_sha, local HEAD is $local_sha." >&2
    echo "        The VM may lack recent fixes/commands — sync it: fleet sync-remote $M_NAME" >&2
  fi
}

cmd_sync_remote() {  # fleet sync-remote [machine] — ship the engine to the VM(s)
  local only="${1:-${machine:-}}"
  local engine_dir; engine_dir="$(cd "$SELF_DIR/.." && pwd)"
  local targets=() m
  if [ -n "$only" ]; then targets=("$only")
  else mapfile -t targets < <(fleet_machines | tr ' ' '\n' | grep -vx local); fi
  [ "${#targets[@]}" -eq 0 ] && { echo "[fleet] sync-remote: no remote machines for '$PROJ_NAME'." >&2; exit 1; }
  echo "[fleet] sync-remote -> ${targets[*]}: ship engine (main) + rebuild image."
  echo "        WARNING: each rebuild recreates that container — its tmux session"
  echo "        and any running remote agents will be stopped."
  read -rp "  continue? [y/N] " ans
  case "${ans:-n}" in y|Y) ;; *) echo "aborted."; exit 1;; esac
  local bundle; bundle="$(mktemp --suffix=.bundle)"
  git -C "$engine_dir" bundle create "$bundle" main >/dev/null   # stderr stays visible: a bundle failure must not abort silently
  local short; short="$(git -C "$engine_dir" rev-parse --short main)"
  for m in "${targets[@]}"; do
    fleet_load_machine "$m" 2>/dev/null || { echo "  skip $m (unknown machine)" >&2; continue; }
    [ "$M_LOCAL" = 1 ] && { echo "  skip $m (local)"; continue; }
    echo "[fleet] $m: $engine_dir (main) -> $M_HOST:~/$M_ENGINE + image rebuild"
    scp -q "$bundle" "$M_HOST:/tmp/fleet-engine.bundle" || { echo "  scp failed for $m" >&2; continue; }
    # ENGINE_SHA stamps the git SHA into the rebuilt image (/opt/agent-fleet/
    # .engine-sha), so version_preflight can later flag a VM that lags the laptop.
    ssh "$M_HOST" "cd ~/$M_ENGINE && git pull -q /tmp/fleet-engine.bundle main && ENGINE_SHA=$short docker compose -f deploy/docker-compose.yml up -d --build" \
      && echo "[fleet] $m updated ($short)." || echo "  remote update failed for $m" >&2
  done
  rm -f "$bundle"
}

# ---------- headless dispatch (detached tmux) ----------

# Local dispatch tmux session name (per project so workers of different projects
# do not share windows). Override with LOCAL_TMUX in the project .env.
dispatch_tmux() { echo "${LOCAL_TMUX:-fleet-$PROJ_NAME}"; }

# Per-project dispatch state: one <name>.status file per worker holding "running"
# or "done rc=N", plus an events.log history. This is how a coordinator (itself
# an agent, so it cannot receive an ntfy push) learns a worker finished: it reads
# `fleet ls` / `fleet wait`. ntfy stays the human's phone ping.
dispatch_state_dir() { echo "$FLEET_ROOT/dispatch/$PROJ_NAME"; }

# Teardown a worker's leftover runtime state once its worktree is gone (del/prune).
# The launch guard has no reaper: a finished worker's tmux window lingers ("kept
# for inspection") and is still counted by guard_probe, so dead windows inflate
# the count and cause false refusals — operators then reach for --force and the
# only rail is off. Removing the window here closes that loop. Local interactive
# and dispatched workers share the dispatch_tmux session, so one kill covers both;
# the remote path (fleet r del) kills the container window separately. Best-effort.
kill_done_windows() {  # <tmux-session> <worker-name> — every _done-<name> window
  # By window id, not name: legacy duplicates make a name target ambiguous.
  local wid
  for wid in $(tmux list-windows -t "$1" -F '#{window_id} #{window_name}' 2>/dev/null \
                 | awk -v n="_done-$2" '$2 == n {print $1}'); do
    tmux kill-window -t "$wid" 2>/dev/null || true
  done
}

# True when a worker still has a tmux window (<name> or _done-<name>) or a
# dispatch sidecar — used by `fleet del` when the worktree is already gone.
worker_runtime_exists() {  # <worker-name> → 0 if leftover state found
  local name="$1" sdir sess
  sdir="$(dispatch_state_dir)"
  if [ -f "$sdir/$name.status" ] || [ -f "$sdir/$name.meta" ]; then
    return 0
  fi
  command -v tmux >/dev/null 2>&1 || return 1
  sess="$(dispatch_tmux)"
  tmux has-session -t "$sess" 2>/dev/null || return 1
  tmux list-windows -t "$sess" -F '#{window_name}' 2>/dev/null \
    | grep -Eqx -- "$name|_done-$name"
}

reap_worker_state() {  # <worker-name>
  local name="$1" sdir
  if command -v tmux >/dev/null 2>&1; then
    # A finished dispatch renamed itself _done-<name> (cmd_dispatch_run).
    tmux kill-window -t "$(dispatch_tmux):$name" 2>/dev/null || true
    kill_done_windows "$(dispatch_tmux)" "$name"
  fi
  sdir="$(dispatch_state_dir)"
  rm -f "$sdir/$name.status" "$sdir/$name.meta"
}

# Reap idle `_done-*` orphan windows (finished dispatch, worktree gone). Safe
# without --force: childless shell, no worktree left to inspect. Called from
# plain `fleet prune` so leftovers do not accumulate across multi-day batches.
reap_idle_done_orphans() {
  local wid wname path live reason logical killed=0 sdir
  sdir="$(dispatch_state_dir)"
  while IFS=$'\t' read -r wid wname path live reason; do
    [ -n "$wname" ] || continue
    case "$wname" in _done-*) ;; *) continue ;; esac
    [ "$live" = idle ] || continue
    tmux kill-window -t "$wid" 2>/dev/null || true
    logical="${wname#_done-}"
    rm -f "$sdir/$logical.status" "$sdir/$logical.meta"
    echo "  reap  $wname (idle _done- orphan, $reason)"
    killed=$((killed + 1))
  done < <(list_orphan_windows)
  [ "$killed" -eq 0 ] || echo "[fleet] prune: $killed idle _done- orphan window(s) reaped."
}

# ---- orphan tmux windows (MAT-122) ----------------------------------------
# A window in the project's local tmux session is an orphan when its pane path
# is gone (tmux appends " (deleted)") or its name (stripping a _done- prefix)
# matches no WT_HOME worktree. Reserved windows (hub, _home) are never orphans.
# Grouped fv-* views share the base session's windows, so killing on
# dispatch_tmux cleans them all. Detection is display-only until
# `fleet prune --windows` (live orphans also need --force).

fleet_reserved_window() {  # <window-name> → 0 if reserved
  case "$1" in hub|_home) return 0 ;; esac
  return 1
}

# Same discriminator as ensure_window_snippet: a childless shell is idle; a
# non-shell command or a shell with children is live. No ps → assume live
# (never kill something we cannot prove idle).
pane_is_live() {  # <tmux-target> → 0 if live
  local info pid cmd
  info="$(tmux display-message -p -t "$1" '#{pane_pid} #{pane_current_command}' 2>/dev/null || true)"
  [ -n "$info" ] || return 0
  pid="${info%% *}"
  cmd="${info##* }"
  case "$cmd" in
    bash|sh|dash|ash|zsh|ksh|fish)
      if [ -n "$pid" ] && command -v ps >/dev/null 2>&1; then
        if ps -o pid= --ppid "$pid" 2>/dev/null | grep -q .; then
          return 0
        fi
        return 1
      fi
      return 0 ;;
    *) return 0 ;;
  esac
}

# Print orphan rows: window_id\twindow_name\tpath\tlive|idle\treason
# reason is deleted-path or no-worktree. Empty if tmux/session missing.
list_orphan_windows() {
  local sess known="" wid wname path reason live logical
  command -v tmux >/dev/null 2>&1 || return 0
  sess="$(dispatch_tmux)"
  tmux has-session -t "$sess" 2>/dev/null || return 0
  known=" $(worktree_paths | while IFS= read -r p; do basename "$p"; done | tr '\n' ' ') "
  while IFS=$'\t' read -r wid wname path; do
    [ -n "$wname" ] || continue
    fleet_reserved_window "$wname" && continue
    logical="$wname"
    case "$wname" in _done-*) logical="${wname#_done-}" ;; esac
    reason=""
    case "$path" in *" (deleted)") reason="deleted-path" ;; esac
    case "$known" in
      *" $logical "*)
        [ -n "$reason" ] || continue  # known worktree + intact path → not orphan
        ;;
      *)
        [ -n "$reason" ] || reason="no-worktree"
        ;;
    esac
    if pane_is_live "$wid"; then live=live; else live=idle; fi
    printf '%s\t%s\t%s\t%s\t%s\n' "$wid" "$wname" "$path" "$live" "$reason"
  done < <(tmux list-windows -t "$sess" -F $'#{window_id}\t#{window_name}\t#{pane_current_path}' 2>/dev/null)
}

report_orphan_windows() {
  local wid wname path live reason n=0
  while IFS=$'\t' read -r wid wname path live reason; do
    [ -n "$wname" ] || continue
    if [ "$n" -eq 0 ]; then
      echo
      echo "orphan windows [$(dispatch_tmux)] (no worktree / deleted pane path) — fleet prune --windows to reap:"
      printf '  %-18s %-8s %-14s %s\n' "WINDOW" "STATE" "REASON" "PANE PATH"
    fi
    n=$((n + 1))
    printf '  %-18s %-8s %-14s %s\n' "$wname" "$live" "$reason" "$path"
  done < <(list_orphan_windows)
  [ "$n" -eq 0 ] || echo "  ($n orphan(s); live ones need fleet --force prune --windows)"
}

prune_orphan_windows() {
  local wid wname path live reason logical killed=0 skipped=0 sdir
  sdir="$(dispatch_state_dir)"
  while IFS=$'\t' read -r wid wname path live reason; do
    [ -n "$wname" ] || continue
    if [ "$live" = live ] && [ -z "$force" ]; then
      echo "  skip  $wname (live orphan — pass --force to kill)"; skipped=$((skipped + 1))
      continue
    fi
    tmux kill-window -t "$wid" 2>/dev/null || true
    logical="$wname"
    case "$wname" in _done-*) logical="${wname#_done-}" ;; esac
    rm -f "$sdir/$logical.status" "$sdir/$logical.meta"
    echo "  reap  $wname ($reason, $live)"; killed=$((killed + 1))
  done < <(list_orphan_windows)
  echo "[fleet] prune --windows: $killed reaped, $skipped skipped (live)."
}

# Keep the append-only dispatch events.log bounded (slow unbounded growth otherwise).
rotate_events_log() {  # <path>
  local f="$1" max=1000 n
  [ -f "$f" ] || return 0
  n="$(wc -l < "$f" 2>/dev/null || echo 0)"
  [ "${n:-0}" -gt "$max" ] 2>/dev/null || return 0
  tail -n "$((max/2))" "$f" > "$f.tmp" 2>/dev/null && mv "$f.tmp" "$f"
}

worker_blocking_server() {  # <worker-name> -> prints server command or returns 1
  local name="$1" LT pid
  LT="$(dispatch_tmux)"
  pid="$(tmux list-panes -t "$LT:$name" -F '#{pane_pid}' 2>/dev/null | head -1 || true)"
  [ -n "$pid" ] || return 1
  python3 "$SELF_DIR/fleet_common.py" check-server "$pid" 2>/dev/null
}

worker_is_stalled() {  # <worker-name> [<worktree-path>] -> 0 if stalled, 1 if not
  local name="$1" path="${2:-}" sdir
  [ -z "$path" ] && [ -n "${WT_HOME:-}" ] && path="$WT_HOME/$name"
  sdir="$(dispatch_state_dir)"
  [ -f "$sdir/$name.status" ] || return 1
  case "$(cat "$sdir/$name.status" 2>/dev/null)" in running*) ;; *) return 1 ;; esac
  [ "${WORKER_STALL_MINUTES:-20}" -le 0 ] 2>/dev/null && return 1
  python3 "$SELF_DIR/fleet_common.py" check-stall "$path" "$sdir/$name.status" "$sdir/$name.meta" 2>/dev/null
}

dispatch_status_label() {  # <worker-name> [<worktree-path>] -> "[dispatch: running] " / "[dispatch: running (stalled)] " / "[dispatch: done rc=0] "
  local name="$1" path="${2:-}" f
  [ -z "$path" ] && [ -n "${WT_HOME:-}" ] && path="$WT_HOME/$name"
  f="$(dispatch_state_dir)/$name.status"
  [ -f "$f" ] || return 0
  local s; s="$(cat "$f" 2>/dev/null)"
  case "$s" in
    running*)
      local srv
      srv="$(worker_blocking_server "$name" 2>/dev/null || true)"
      if [ -n "$srv" ]; then
        if worker_is_stalled "$name" "$path"; then
          printf '[dispatch: %s (stalled, blocked on %s)] ' "$s" "$srv"
        else
          printf '[dispatch: blocked-on-foreground-process (%s)] ' "$srv"
        fi
        return 0
      fi
      if worker_is_stalled "$name" "$path"; then
        printf '[dispatch: %s (stalled)] ' "$s"
        return 0
      fi
      ;;
  esac
  printf '[dispatch: %s] ' "$s"
  # Advisory: finished rc=0 but left no commit and a clean tree (silent no-op).
  if [ "$s" = "done rc=0" ] && [ -n "$path" ] &&
     python3 "$SELF_DIR/fleet_common.py" wait-summary "$path" "$f" "" "${DEFAULT_BASE:-}" --json 2>/dev/null |
       grep -q '"empty": true'; then
    printf '[no changes] '
  fi
}

# Provenance sidecar (WS3): record which coordinator spawned a worker and how.
# Read by `fleet status` to rebuild the coordinator -> workers tree. A worker
# with no parent (a bare `fleet w` started by a human) is "independent".
write_worker_meta() {  # <worker-name> <mode: dispatch|interactive> [deliverable] [pack] [difficulty] [kind] [escalate] [scope] [checks]
  local name="$1" mode="$2" deliv="${3:-}" pack="${4:-}"
  local diff="${5:-}" kind="${6:-}" esc="${7:-}" scope="${8:-}" checks="${9:-}"
  local sdir; sdir="$(dispatch_state_dir)"; mkdir -p "$sdir"
  {
    printf 'machine=%s\n'     "${FLEET_MACHINE:-local}"
    printf 'parent=%s\n'      "${FLEET_COORDINATOR:-}"
    printf 'mode=%s\n'        "$mode"
    printf 'created=%s\n'     "$(date -u +%FT%TZ 2>/dev/null || echo '')"
    [ -n "$deliv" ] && printf 'deliverable=%s\n' "$deliv"
    [ -n "$pack" ]  && printf 'pack=%s\n'        "$pack"
    [ -n "$diff" ]  && printf 'difficulty=%s\n'  "$diff"
    [ -n "$kind" ]  && printf 'kind=%s\n'        "$kind"
    [ -n "$esc" ]   && printf 'escalate=%s\n'    "$esc"
    [ -n "$scope" ] && printf 'scope=%s\n'       "$scope"
    [ -n "$checks" ] && printf 'checks=%s\n'      "$checks"
    printf 'retries=0\n'
  } > "$sdir/$name.meta"
}

cmd_dispatch() {  # fleet [--machine M] dispatch [--auto] [--difficulty D] [--kind K] [--escalate] [--wait] [--deliverable [pr|push]] [--scope GLOBS] [--checks LIST] [--spec FILE] [--model M] <name> "<task>" [base]
  local model="" taskfile_in="" auto="" difficulty="" kind="" escalate="" wait_after=0 deliverable_req=""
  local scope_req="" checks_req="" spec_file=""
  # Leading flags (dispatch's own; the global --machine is already parsed).
  # --task-file is the transport for remote dispatch (task shipped as a file so
  # multi-line prompts never fight ssh->docker->bash quoting); it is consumed
  # (deleted) after reading, same as _dispatch-run's taskfile.
  while :; do
    case "${1:-}" in
      --wait)       wait_after=1; shift ;;
      --model)      [ $# -ge 2 ] || { echo "error: --model needs a value" >&2; exit 2; }; model="$2"; shift 2 ;;
      --task-file)  [ $# -ge 2 ] || { echo "error: --task-file needs a value" >&2; exit 2; }; taskfile_in="$2"; shift 2 ;;
      --auto)       auto=1; shift ;;
      --difficulty) [ $# -ge 2 ] || { echo "error: --difficulty needs a value" >&2; exit 2; }; difficulty="$2"; shift 2 ;;
      --kind)       [ $# -ge 2 ] || { echo "error: --kind needs a value" >&2; exit 2; }; kind="$2"; shift 2 ;;
      --escalate)   escalate=1; shift ;;
      --deliverable|--require-deliverable)
        if [ $# -ge 2 ] && case "${2:-}" in pr|push) true ;; *) false ;; esac; then
          deliverable_req="$2"; shift 2
        else
          deliverable_req="pr"; shift 1
        fi
        ;;
      --scope)      [ $# -ge 2 ] || { echo "error: --scope needs a value" >&2; exit 2; }
                    scope_req="$(python3 "$SELF_DIR/fleet_checks.py" norm-scope "$2")" || exit 2; shift 2 ;;
      --checks)     [ $# -ge 2 ] || { echo "error: --checks needs a value" >&2; exit 2; }
                    checks_req="$(python3 "$SELF_DIR/fleet_checks.py" norm-checks "$2")" || exit 2; shift 2 ;;
      --spec)       [ $# -ge 2 ] || { echo "error: --spec needs a file" >&2; exit 2; }; spec_file="$2"; shift 2 ;;
      *) break ;;
    esac
  done
  # Structured task spec (deliverable / scope / checks): explicit flags win, the
  # spec file only fills what the flags left empty.
  if [ -n "$spec_file" ]; then
    local spec_out sk sv
    spec_out="$(python3 "$SELF_DIR/fleet_checks.py" parse-spec "$spec_file")" || exit 2
    while IFS='=' read -r sk sv; do
      case "$sk" in
        deliverable) [ -n "$deliverable_req" ] || deliverable_req="$sv" ;;
        scope)       [ -n "$scope_req" ] || scope_req="$sv" ;;
        checks)      [ -n "$checks_req" ] || checks_req="$sv" ;;
      esac
    done <<< "$spec_out"
  fi
  local name="${1:-}"; shift || true
  local task=""
  if [ -n "$taskfile_in" ]; then
    task="$(cat "$taskfile_in" 2>/dev/null)"; rm -f "$taskfile_in"
  else
    task="${1:-}"; shift || true
  fi
  local base="${1:-}"
  [ -z "$name" ] || [ -z "$task" ] && { echo "usage: fleet [--machine M] dispatch [--auto] [--difficulty D] [--kind K] [--escalate] [--wait] [--deliverable [pr|push]] [--scope GLOBS] [--checks LIST] [--spec FILE] [--model M] <name> \"<task>\" [base]" >&2; exit 2; }
  fleet_valid_name "$name" "worker name" || exit 2   # threads through tmux/ssh unquoted

  # Check recursion depth limit (prevents runaway dispatch chains)
  local cur_depth="${FLEET_DISPATCH_DEPTH:-0}"
  local max_depth="${ROUTE_MAX_DEPTH:-${FLEET_DEF_ROUTE_MAX_DEPTH:-2}}"
  if [ "$cur_depth" -ge "$max_depth" ] 2>/dev/null; then
    echo "error: max dispatch depth ($max_depth) reached (current=$cur_depth)" >&2
    exit 2
  fi

  # Auto-routing if requested or difficulty/kind/escalate provided
  if [ -n "$auto" ] || [ -n "$difficulty" ] || [ -n "$kind" ] || [ -n "$escalate" ]; then
    local r_out r_agent="" r_model=""
    local r_args=()
    [ -n "$difficulty" ] && r_args+=(--difficulty "$difficulty")
    [ -n "$kind" ] && r_args+=(--kind "$kind")
    [ -n "$escalate" ] && r_args+=(--escalate)
    [ -n "$task" ] && r_args+=(--task "$task")
    r_out="$(python3 "$SELF_DIR/fleet-route.py" "${r_args[@]}")" || exit $?
    if [[ "$r_out" == *:* ]]; then
      r_agent="${r_out%%:*}"
      r_model="${r_out#*:}"
    else
      r_agent="$r_out"
      r_model=""
    fi
    [ -z "$agent" ] && agent="$r_agent"
    [ -z "$model" ] && [ -n "$r_model" ] && model="$r_model"
    local sdir; sdir="$(dispatch_state_dir)"; mkdir -p "$sdir"
    printf '%s %s route %s:%s\n' "$(date -u +%FT%TZ 2>/dev/null)" "$name" "$agent" "${model:-default}" >> "$sdir/events.log"
    rotate_events_log "$sdir/events.log"
  fi

  need_agent
  # Resolve the target machine (honors --machine); dispatch defaults to local.
  target_machine local
  # --- remote dispatch: delegate to the container's OWN fleet ---------------
  if [ "$M_LOCAL" != 1 ]; then
    command -v ssh >/dev/null || { echo "error: remote dispatch needs ssh" >&2; exit 2; }
    version_preflight   # non-fatal warning if the VM engine lags the local one
    local b64; b64="$(printf '%s' "$task" | base64 | tr -d '\n')"
    local inner="tf=\$(mktemp); echo $b64 | base64 -d > \$tf; fleet --project $M_PROJECT${agent:+ -a $agent} dispatch${model:+ --model $model}${auto:+ --auto}${difficulty:+ --difficulty $difficulty}${kind:+ --kind $kind}${escalate:+ --escalate}${deliverable_req:+ --deliverable $deliverable_req}${scope_req:+ --scope \"$scope_req\"}${checks_req:+ --checks \"$checks_req\"} --task-file \$tf $name${base:+ $base}"
    ssh "$M_HOST" "docker exec $M_CONTAINER bash -lc '$inner'"
    return $?
  fi
  # --- local dispatch -------------------------------------------------------
  need_code_repo
  fleet_guard_lock || exit 2
  fleet_guard || exit 2
  command -v tmux >/dev/null || { echo "error: dispatch needs tmux (detached worker window)" >&2; exit 2; }
  fleet_load_pack "$agent"
  declare -F pack_launch_headless >/dev/null \
    || { echo "error: pack '$agent' has no headless mode (pack_launch_headless)" >&2; exit 2; }
  mkdir -p "$(dispatch_state_dir)"
  fleet_warn_model_ignored "$agent" "$model" "$(dispatch_state_dir)/events.log"
  local dest="$WT_HOME/$name"
  if [ ! -d "$dest" ]; then
    "$NEW_WORKER" "$name" "${base:-${DEFAULT_BASE:-origin/main}}" || exit 1
  fi
  if [ -z "$deliverable_req" ]; then
    # Deprecated: deliverable markers in the task prose (use --deliverable or a
    # --spec file). Still parsed for one release, with a warning.
    case "$task" in
      *"[deliverable: push]"*|*"DELIVERABLE: push"*|*"[require-deliverable: push]"*) deliverable_req="push" ;;
      *"[deliverable:"*|*"DELIVERABLE:"*|*"[require-deliverable:"*) deliverable_req="pr" ;;
      *) deliverable_req="${WORKER_REQUIRE_DELIVERABLE:-}" ;;
    esac
    case "$task" in
      *"[deliverable:"*|*"DELIVERABLE:"*|*"[require-deliverable:"*)
        echo "warning: deliverable markers in the task text are deprecated (parsed for one more release); use 'fleet dispatch --deliverable [pr|push]' or a --spec file" >&2 ;;
    esac
  fi
  local sdir; sdir="$(dispatch_state_dir)"; mkdir -p "$sdir"
  printf '%s\n' "$task" > "$sdir/$name.task"
  write_worker_meta "$name" dispatch "$deliverable_req" "$agent" "$difficulty" "$kind" "$escalate" "$scope_req" "$checks_req"
  local taskfile; taskfile="$(mktemp "${TMPDIR:-/tmp}/fleet-task.XXXXXX")"
  printf '%s\n' "$task" > "$taskfile"
  printf 'running' > "$sdir/$name.status"
  local LT; LT="$(dispatch_tmux)"
  # NOT `exec fleet`: control must return after the worker so _dispatch-run can
  # record completion + notify, and the window is kept for inspection.
  # Pin the env IN the command: a persistent tmux server keeps a stale
  # environment that new windows inherit. Setting FLEET_CONF here pins the
  # already-resolved project for the headless child (no --project on this
  # inner line). `env VAR=val` wins over whatever the server carries.
  # FLEET_MODEL (when --model is given) rides the same way to pack_launch_headless.
  local run="env FLEET_CONF='$CONF' FLEET_HOME='$FLEET_ROOT' FLEET_PACKS_DIR='$FLEET_PACKS_DIR' FLEET_DISPATCH_DEPTH='$((cur_depth + 1))'${model:+ FLEET_MODEL='$model'} fleet -a $agent _dispatch-run $name $taskfile"
  tmux has-session -t "$LT" 2>/dev/null || tmux new-session -d -s "$LT" -n _home
  tmux kill-window -t "$LT:$name" 2>/dev/null || true
  kill_done_windows "$LT" "$name"
  tmux new-window -t "$LT" -n "$name" \
    "$run; echo; echo '[worker $name exited — window kept for inspection; Ctrl-b & to close]'; exec bash"
  fleet_guard_unlock
  echo "dispatched: worker '$name' ($agent, headless${model:+, model=$model}) -> tmux $LT:$name"
  if [ "$wait_after" -eq 1 ]; then
    cmd_wait "$name"
    return $?
  fi
  echo "  wake coordinator: run 'fleet wait $name' in background to wake on exit"
  echo "  monitor : fleet ls   ·   watch: fleet attach   ·   block: fleet wait $name"
}

worker_has_quota_error() {  # <worker-name> [pack] [out_file] [pane_target]
  local name="$1" pack="${2:-}" out_file="${3:-}" pane_target="${4:-}"
  local sdir; sdir="$(dispatch_state_dir)"
  local f="$sdir/$name.status"
  case "$(cat "$f" 2>/dev/null)" in
    done\ rc=0*) return 1 ;;
  esac

  if [ -z "$pack" ] && [ -f "$sdir/$name.meta" ]; then
    pack="$(sed -n 's/^pack=//p' "$sdir/$name.meta" 2>/dev/null | head -1)"
  fi
  [ -z "$pack" ] && pack="$(fleet_default_agent)"
  pack="${pack%%:*}"

  # 1. Consult quota ledger
  local ledger="$FLEET_ROOT/quota/$pack"
  if [ -f "$ledger" ]; then
    local exp now
    exp="$(cat "$ledger" 2>/dev/null || true)"
    now="$(date +%s)"
    if [ -n "$exp" ] && [ "$exp" -gt "$now" ] 2>/dev/null; then
      return 0
    else
      rm -f "$ledger" 2>/dev/null || true
    fi
  fi
  # 2. Check pack quota pattern
  fleet_load_pack "$pack" 2>/dev/null || true
  local quota_pat=""
  if declare -F pack_quota_pattern >/dev/null 2>&1; then
    quota_pat="$(pack_quota_pattern 2>/dev/null || true)"
  fi
  [ -z "$quota_pat" ] && return 1

  local quota_matched=0
  if [ -n "$out_file" ] && [ -f "$out_file" ] && grep -q -E "$quota_pat" "$out_file" 2>/dev/null; then
    quota_matched=1
  elif [ -n "$pane_target" ] && tmux capture-pane -p -t "$pane_target" 2>/dev/null | grep -q -E "$quota_pat"; then
    quota_matched=1
  else
    local LT
    LT="$(dispatch_tmux)"
    if tmux capture-pane -pt "$LT:_done-$name" 2>/dev/null | grep -q -E "$quota_pat"; then
      quota_matched=1
    elif tmux capture-pane -pt "$LT:$name" 2>/dev/null | grep -q -E "$quota_pat"; then
      quota_matched=1
    fi
  fi

  # 3. Write to quota ledger and log event if matched
  if [ "$quota_matched" -eq 1 ]; then
    local ttl="${ROUTE_QUOTA_TTL_SEC:-${FLEET_DEF_ROUTE_QUOTA_TTL_SEC:-21600}}"
    local now_epoch exp_epoch
    now_epoch="$(date +%s)"
    exp_epoch="$((now_epoch + ttl))"
    mkdir -p "$FLEET_ROOT/quota"
    printf '%s\n' "$exp_epoch" > "$FLEET_ROOT/quota/$pack"
    echo "[fleet] pack '$pack' quota exceeded (pattern '$quota_pat' matched) — recorded in $FLEET_ROOT/quota/$pack (expires in ${ttl}s)" >&2
    if [ -d "$sdir" ]; then
      printf '%s %s quota-exceeded pack=%s expires=%s\n' "$(date -u +%FT%TZ 2>/dev/null)" "$name" "$pack" "$exp_epoch" >> "$sdir/events.log"
      rotate_events_log "$sdir/events.log"
    fi
    return 0
  fi

  return 1
}

cmd_dispatch_run() {  # internal: foreground headless launch inside a tmux window
  local name="${1:-}" taskfile="${2:-}"
  [ -z "$name" ] || [ -z "$taskfile" ] && { echo "error: _dispatch-run <name> <taskfile>" >&2; exit 2; }
  need_code_repo; need_agent
  local dest="$WT_HOME/$name"
  [ -d "$dest" ] || { echo "error: no worktree $dest" >&2; exit 1; }
  local task; task="$(cat "$taskfile" 2>/dev/null)"; rm -f "$taskfile"
  [ -n "$task" ] || { echo "error: empty task" >&2; exit 1; }
  local preamble="You are a code WORKER in the git worktree $dest (branch $name)."
  [ -n "${HUB:-}" ] && preamble="$preamble The docs hub at $HUB is READ-ONLY: do not edit it; if a hub doc needs changing, note it for the coordinator (do not write there)."
  preamble="$preamble Do NOT run long-lived servers or watch modes in the foreground (e.g. 'npm run dev', 'vite', 'uvicorn', '--watch'); run background commands or use nohup/& if needed."
  preamble="$preamble Do the task, run the tests, commit on this branch. Task follows."
  fleet_load_pack "$agent"
  cd "$dest"
  # Run the worker in a subshell so pack_launch_headless's exec is contained and
  # control returns here to record completion (the "worker finished" signal).
  # FLEET_MODEL (set by `dispatch --model`) is passed as $2; packs that support a
  # per-launch model (PACK_MODEL_FLAG) use it; the warning was raised at dispatch.
  # CRITICAL: this file runs under `set -e`. A bare failing subshell aborts before
  # `rc=$?` and the status write — coordinators then see forever-"running" and
  # `fleet wait` hangs (MAT-13). Disable -e around the launch; restore after.
  local out_file; out_file="$(mktemp)"
  set +e
  ( pack_launch_headless "$preamble

$task" "${FLEET_MODEL:-}" ) 2>&1 | tee "$out_file"
  local rc="${PIPESTATUS[0]}"
  set -e
  local sdir; sdir="$(dispatch_state_dir)"; mkdir -p "$sdir"
  local deliv=""
  [ -f "$sdir/$name.meta" ] && deliv="$(sed -n 's/^deliverable=//p' "$sdir/$name.meta" 2>/dev/null | head -1)"
  [ -z "$deliv" ] && deliv="${WORKER_REQUIRE_DELIVERABLE:-}"
  if [ "$rc" -eq 0 ] && [ -n "$deliv" ]; then
    if ! python3 "$SELF_DIR/fleet_common.py" check-deliverable "$dest" "$name" "$deliv" >/dev/null 2>&1; then
      printf 'done-without-deliverable' > "$sdir/$name.status"
      printf '%s %s done-without-deliverable\n' "$(date -u +%FT%TZ 2>/dev/null)" "$name" >> "$sdir/events.log"
      rotate_events_log "$sdir/events.log"
      [ -n "${NTFY_TOPIC:-}" ] && "$NOTIFY" "$NTFY_TOPIC" "$name" "done-without-deliverable" >/dev/null 2>&1
      echo "[fleet] worker '$name' finished without required deliverable ($deliv) — recorded as done-without-deliverable"
      if [ -n "${TMUX:-}" ] && [ -n "${TMUX_PANE:-}" ]; then
        tmux rename-window -t "$TMUX_PANE" "_done-$name" 2>/dev/null || true
      fi
      return 1
    fi
  fi
  # Scope allowlist (dispatch spec): same checks/report mechanism as `fleet gate`.
  if [ "$rc" -eq 0 ] && [ -f "$sdir/$name.meta" ]; then
    local m_scope m_checks scope_out scope_rc=0
    m_scope="$(sed -n 's/^scope=//p' "$sdir/$name.meta" | head -1)"
    m_checks="$(sed -n 's/^checks=//p' "$sdir/$name.meta" | head -1)"
    if [ -n "$m_scope" ]; then
      scope_out="$(python3 "$SELF_DIR/fleet_checks.py" run --root "$dest" --base "${DEFAULT_BASE:-origin/main}" --checks "$m_checks" --scope "$m_scope")" || scope_rc=$?
      if [ -n "$scope_out" ]; then
        echo "$scope_out"
        printf '%s %s scope-violation\n' "$(date -u +%FT%TZ 2>/dev/null)" "$name" >> "$sdir/events.log"
        rotate_events_log "$sdir/events.log"
      fi
      if [ "$scope_rc" -eq 1 ]; then
        printf 'done-out-of-scope' > "$sdir/$name.status"
        printf '%s %s done-out-of-scope\n' "$(date -u +%FT%TZ 2>/dev/null)" "$name" >> "$sdir/events.log"
        [ -n "${NTFY_TOPIC:-}" ] && "$NOTIFY" "$NTFY_TOPIC" "$name" "done-out-of-scope" >/dev/null 2>&1
        echo "[fleet] worker '$name' changed paths outside its scope (blocking) — recorded as done-out-of-scope"
        if [ -n "${TMUX:-}" ] && [ -n "${TMUX_PANE:-}" ]; then
          tmux rename-window -t "$TMUX_PANE" "_done-$name" 2>/dev/null || true
        fi
        return 1
      fi
    fi
  fi
  printf 'done rc=%s' "$rc" > "$sdir/$name.status"
  printf '%s %s done rc=%s\n' "$(date -u +%FT%TZ 2>/dev/null)" "$name" "$rc" >> "$sdir/events.log"
  rotate_events_log "$sdir/events.log"   # keep the append-only history bounded

  if [ "$rc" -ne 0 ]; then
    worker_has_quota_error "$name" "$agent" "$out_file" "${TMUX_PANE:-}" || true
  fi
  rm -f "$out_file"
  # Human's phone ping (best effort), same channel as the pack Stop hooks.
  [ -n "${NTFY_TOPIC:-}" ] && "$NOTIFY" "$NTFY_TOPIC" "$name" "done rc=$rc" >/dev/null 2>&1
  echo "[fleet] worker '$name' finished (rc=$rc) — recorded for the coordinator (fleet ls / fleet wait)"
  # Free the MAX_WORKERS slot while keeping the pane for peek/inspection.
  # guard_probe_snippet ignores ^_done- (pack-interop dogfood 2026-09-25: a
  # coordinator hit 6/6 on finished bash panes and could not dispatch again).
  if [ -n "${TMUX:-}" ] && [ -n "${TMUX_PANE:-}" ]; then
    tmux rename-window -t "$TMUX_PANE" "_done-$name" 2>/dev/null || true
  fi
  return "$rc"
}

cmd_attach() {  # attach the local machine's tmux session (coordinator + workers)
  machine=local; target_machine
  session_attach
}

worker_next_agent() {  # <current_pack> [worker-name] -> prints next pack in route or AGENTS
  local cur="$1" name="${2:-}"
  local cur_agent="${cur%%:*}"

  local routing_configured=0
  if [ -n "$name" ]; then
    local sdir; sdir="$(dispatch_state_dir)"
    if [ -f "$sdir/$name.meta" ] && grep -q -E '^(route=|difficulty=|kind=|escalate=)' "$sdir/$name.meta" 2>/dev/null; then
      routing_configured=1
    elif [ -n "${ROUTE_EASY:-}" ] || [ -n "${ROUTE_MEDIUM:-}" ] || [ -n "${ROUTE_HARD:-}" ] || [ -f "${FLEET_ROOT:-$FLEET_HOME}/routing.env" ]; then
      routing_configured=1
    elif [ -n "${CONF:-}" ] && [ -f "$CONF" ] && grep -q -E '^ROUTE_(EASY|MEDIUM|HARD)=' "$CONF" 2>/dev/null; then
      routing_configured=1
    fi
  fi

  if [ "$routing_configured" -eq 1 ]; then
    local sdir; sdir="$(dispatch_state_dir)"
    local meta_file="$sdir/$name.meta"
    local r_args=()
    local task_text=""
    [ -f "$sdir/$name.task" ] && task_text="$(cat "$sdir/$name.task" 2>/dev/null || true)"
    [ -n "$task_text" ] && r_args+=(--task "$task_text")

    local diff kind esc
    diff="$(sed -n 's/^difficulty=//p' "$meta_file" 2>/dev/null | head -1)"
    kind="$(sed -n 's/^kind=//p' "$meta_file" 2>/dev/null | head -1)"
    esc="$(sed -n 's/^escalate=//p' "$meta_file" 2>/dev/null | head -1)"
    [ -n "$diff" ] && r_args+=(--difficulty "$diff")
    [ -n "$kind" ] && r_args+=(--kind "$kind")
    [ "$esc" = "1" ] && r_args+=(--escalate)
    r_args+=(--exclude "$cur_agent")

    local sdir_bin="${SELF_DIR:-}"
    [ -z "$sdir_bin" ] && sdir_bin="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)"
    [ -f "$sdir_bin/fleet-route.py" ] || sdir_bin="$(dirname "$(command -v fleet 2>/dev/null || true)")"

    local next_route
    if [ -f "$sdir_bin/fleet-route.py" ]; then
      if next_route="$(python3 "$sdir_bin/fleet-route.py" ${PROJ_NAME:+--project "$PROJ_NAME"} "${r_args[@]}" 2>/dev/null)" && [ -n "$next_route" ]; then
        echo "$next_route"
        return 0
      fi
    fi
  fi

  local found=0 a
  for a in $(fleet_agents); do
    if [ "$found" -eq 1 ]; then
      echo "$a"; return 0
    fi
    [ "$a" = "$cur_agent" ] && found=1
  done
  return 1
}

worker_trigger_retry_or_fallback() {  # <worker-name> <reason> -> 0 if re-dispatched, 1 if exhausted/cannot
  local name="$1" reason="$2" sdir dest meta_file task_file
  sdir="$(dispatch_state_dir)"
  meta_file="$sdir/$name.meta"
  task_file="$sdir/$name.task"
  dest="${WT_HOME:-}/$name"
  [ -f "$task_file" ] || return 1
  local original_task; original_task="$(cat "$task_file" 2>/dev/null)"
  [ -n "$original_task" ] || return 1

  local cur_pack cur_retries max_retries deliv
  cur_pack="$(sed -n 's/^pack=//p' "$meta_file" 2>/dev/null | head -1)"
  [ -z "$cur_pack" ] && cur_pack="$(fleet_default_agent)"
  cur_retries="$(sed -n 's/^retries=//p' "$meta_file" 2>/dev/null | head -1)"
  cur_retries="${cur_retries:-0}"
  max_retries="${WORKER_MAX_RETRIES:-0}"
  deliv="$(sed -n 's/^deliverable=//p' "$meta_file" 2>/dev/null | head -1)"
  local spec_scope spec_checks
  spec_scope="$(sed -n 's/^scope=//p' "$meta_file" 2>/dev/null | head -1)"
  spec_checks="$(sed -n 's/^checks=//p' "$meta_file" 2>/dev/null | head -1)"

  mkdir -p "$sdir"
  local log_file="$sdir/supervision.log"

  if [ "$reason" != "quota" ] && [ "$cur_retries" -lt "$max_retries" ]; then
    local new_retries=$((cur_retries + 1))
    sed -i "s/^retries=.*/retries=$new_retries/" "$meta_file" 2>/dev/null || echo "retries=$new_retries" >> "$meta_file"
    printf '%s %s retry pack=%s attempt=%s/%s reason=%s\n' \
      "$(date -u +%FT%TZ 2>/dev/null)" "$name" "$cur_pack" "$new_retries" "$max_retries" "$reason" >> "$log_file"
    rotate_events_log "$log_file"
    echo "[fleet supervision] worker '$name' ($cur_pack) $reason — auto-retrying (attempt $new_retries/$max_retries)"
    local resume_prompt="RESUMPTION: You previously stopped ($reason). Check git status and worktree in $dest (branch $name) and complete the task.\n\n$original_task"
    local LT; LT="$(dispatch_tmux)"
    tmux kill-window -t "$LT:$name" 2>/dev/null || true
    agent="$cur_pack" cmd_dispatch ${deliv:+--deliverable $deliv} ${spec_scope:+--scope "$spec_scope"} ${spec_checks:+--checks "$spec_checks"} "$name" "$(printf '%b' "$resume_prompt")"
    return 0
  else
    local next_pack
    next_pack="$(worker_next_agent "$cur_pack" "$name")" || true
    if [ -n "$next_pack" ]; then
      local next_agent next_model=""
      if [[ "$next_pack" == *:* ]]; then
        next_agent="${next_pack%%:*}"
        next_model="${next_pack#*:}"
      else
        next_agent="$next_pack"
      fi
      sed -i "s/^pack=.*/pack=$next_pack/" "$meta_file" 2>/dev/null || echo "pack=$next_pack" >> "$meta_file"
      sed -i "s/^retries=.*/retries=0/" "$meta_file" 2>/dev/null || echo "retries=0" >> "$meta_file"
      printf '%s %s fallback from=%s to=%s reason=%s\n' \
        "$(date -u +%FT%TZ 2>/dev/null)" "$name" "$cur_pack" "$next_pack" "$reason" >> "$log_file"
      rotate_events_log "$log_file"
      echo "[fleet supervision] worker '$name' exhausted retries on $cur_pack — falling back to $next_pack"
      local fallback_prompt="RESUMPTION (PACK FALLBACK): You are taking over with agent '$next_pack' after '$cur_pack' stopped ($reason). Inspect worktree in $dest (branch $name) and complete the task.\n\n$original_task"
      local LT; LT="$(dispatch_tmux)"
      tmux kill-window -t "$LT:$name" 2>/dev/null || true
      agent="$next_agent" cmd_dispatch ${next_model:+--model $next_model} ${deliv:+--deliverable $deliv} ${spec_scope:+--scope "$spec_scope"} ${spec_checks:+--checks "$spec_checks"} "$name" "$(printf '%b' "$fallback_prompt")"
      return 0
    else
      printf '%s %s exhausted pack=%s reason=%s\n' \
        "$(date -u +%FT%TZ 2>/dev/null)" "$name" "$cur_pack" "$reason" >> "$log_file"
      rotate_events_log "$log_file"
      echo "[fleet supervision] worker '$name' exhausted all retries and packs in AGENTS ($reason)"
      return 1
    fi
  fi
}

cmd_retry() {  # fleet retry [--fallback] [--pack P] <name>
  local fallback=0 forced_pack=""
  while :; do
    case "${1:-}" in
      --fallback) fallback=1; shift ;;
      --pack)     [ $# -ge 2 ] || { echo "error: --pack needs a value" >&2; exit 2; }; forced_pack="$2"; shift 2 ;;
      *) break ;;
    esac
  done
  local name="${1:-}"
  [ -z "$name" ] && { echo "usage: fleet retry [--fallback] [--pack P] <name>" >&2; exit 2; }
  need_code_repo
  local sdir; sdir="$(dispatch_state_dir)"
  [ -f "$sdir/$name.task" ] || { echo "error: no task history for worker '$name'" >&2; exit 1; }
  if [ -n "$forced_pack" ]; then
    fleet_agent_enabled "$forced_pack" || { echo "error: pack '$forced_pack' is not enabled in AGENTS" >&2; exit 2; }
    sed -i "s/^pack=.*/pack=$forced_pack/" "$sdir/$name.meta" 2>/dev/null || echo "pack=$forced_pack" >> "$sdir/$name.meta"
    sed -i "s/^retries=.*/retries=0/" "$sdir/$name.meta" 2>/dev/null || echo "retries=0" >> "$sdir/$name.meta"
  elif [ "$fallback" -eq 1 ]; then
    local cur; cur="$(sed -n 's/^pack=//p' "$sdir/$name.meta" 2>/dev/null | head -1)"
    [ -z "$cur" ] && cur="$(fleet_default_agent)"
    local next; next="$(worker_next_agent "$cur" "$name")" || { echo "error: no next pack in AGENTS after $cur" >&2; exit 1; }
    sed -i "s/^pack=.*/pack=$next/" "$sdir/$name.meta" 2>/dev/null || echo "pack=$next" >> "$sdir/$name.meta"
    sed -i "s/^retries=.*/retries=0/" "$sdir/$name.meta" 2>/dev/null || echo "retries=0" >> "$sdir/$name.meta"
  fi
  worker_trigger_retry_or_fallback "$name" "manual-retry"
}

cmd_wait() {  # fleet wait [--json] [<name>] — block until dispatched worker(s) finish, then report
  local as_json=0
  if [ "${1:-}" = "--json" ]; then
    as_json=1; shift
  fi
  local target="${1:-}" dir; dir="$(dispatch_state_dir)"
  [ -d "$dir" ] || { echo "no dispatched workers for '$PROJ_NAME'." >&2; return 0; }
  if [ -n "$target" ] && [ ! -f "$dir/$target.status" ]; then
    echo "no dispatched worker '$target' for '$PROJ_NAME'." >&2; return 2
  fi
  local f n pending stalled_any
  while :; do
    pending=0
    stalled_any=0
    for f in "$dir"/*.status; do
      [ -e "$f" ] || continue
      n="$(basename "$f" .status)"
      [ -n "$target" ] && [ "$n" != "$target" ] && continue
      case "$(cat "$f" 2>/dev/null)" in
        running*)
          if worker_is_stalled "$n"; then
            if [ "${WORKER_MAX_RETRIES:-0}" -gt 0 ] && worker_trigger_retry_or_fallback "$n" "stall"; then
              pending=1
            else
              stalled_any=1
            fi
          else
            pending=1
          fi
          ;;
        done\ rc=*)
          local s; s="$(cat "$f" 2>/dev/null)"
          if [ "$s" != "done rc=0" ] && [ "${WORKER_MAX_RETRIES:-0}" -gt 0 ] && worker_has_quota_error "$n"; then
            if worker_trigger_retry_or_fallback "$n" "quota"; then
              pending=1
            fi
          fi
          ;;
      esac
    done
    [ "$stalled_any" -eq 1 ] && break
    [ "$pending" -eq 0 ] && break
    sleep "${FLEET_WAIT_POLL:-3}"
  done
  local worst=0
  local json_items=()
  for f in "$dir"/*.status; do
    [ -e "$f" ] || continue
    n="$(basename "$f" .status)"
    [ -n "$target" ] && [ "$n" != "$target" ] && continue
    local s; s="$(cat "$f" 2>/dev/null)"
    case "$s" in
      running*)
        if worker_is_stalled "$n"; then
          s="$s (stalled)"
          worst=3
        else
          [ "$worst" -lt 1 ] && worst=1
        fi
        ;;
      done\ rc=0) ;;
      done-without-deliverable*|done-out-of-scope*)
        [ "$worst" -lt 1 ] && worst=1
        ;;
      done\ rc=*)
        [ "$worst" -lt 1 ] && worst=1
        ;;
    esac
    local path="${WT_HOME:-}/$n"
    local meta="$dir/$n.meta"
    local summary
    summary="$(python3 "$SELF_DIR/fleet_common.py" wait-summary "$path" "$f" "$meta" "${DEFAULT_BASE:-}" 2>/dev/null || echo "worker=$n status=\"$s\"")"
    if [ "$as_json" -eq 1 ]; then
      local json_data
      json_data="$(python3 "$SELF_DIR/fleet_common.py" wait-summary "$path" "$f" "$meta" "${DEFAULT_BASE:-}" --json 2>/dev/null || echo "{}")"
      json_items+=("$json_data")
    else
      printf '  %-18s %s\n' "$n" "$s"
      printf '  summary: %s\n' "$summary"
    fi
    # Optional notification hook / topic on finish or stall
    if [ -n "${FLEET_NOTIFY_HOOK:-}" ] && [ -x "${FLEET_NOTIFY_HOOK:-}" ]; then
      "$FLEET_NOTIFY_HOOK" "$n" "$s" "$worst" >/dev/null 2>&1 || true
    fi
    if [ "${FLEET_WAIT_NOTIFY:-0}" = 1 ] && [ -n "${NTFY_TOPIC:-}" ]; then
      "$NOTIFY" "$NTFY_TOPIC" "$n" "$s" >/dev/null 2>&1 || true
    fi
  done
  if [ "$as_json" -eq 1 ]; then
    printf '[%s]\n' "$(IFS=,; echo "${json_items[*]}")"
  fi
  return "$worst"
}

# ---------- global (per-user instructions) ----------
# global_canon() is defined in fleet-config.sh (shared with pack_worker_setup).

# Seed the canonical file if absent. If ~/.claude/CLAUDE.md already holds user
# instructions (and is not yet the @import bridge), MIGRATE it: back it up, make
# it the canonical seed, and empty it so the claude pack writes the import.
global_ensure_canon() {
  local canon="$1" claudemd="$HOME/.claude/CLAUDE.md" imp="@$1" tpl
  mkdir -p "$(dirname "$canon")"
  [ -e "$canon" ] && return 0
  if [ -s "$claudemd" ] && ! grep -qxF "$imp" "$claudemd"; then
    cp "$claudemd" "$claudemd.bak"
    cp "$claudemd" "$canon"
    : > "$claudemd"
    echo "[fleet] migrated $claudemd -> $canon (backup: $claudemd.bak)"
  else
    tpl="$SELF_DIR/../templates/global-AGENTS.md"
    if [ -f "$tpl" ]; then fleet_seed_from_template "$tpl" "$canon"; else printf '# global agent instructions\n' > "$canon"; fi
    echo "[fleet] seeded $canon"
  fi
}

# Per-pack report/wire. mode=install wires; mode=status is read-only. Each pack's
# pack_global_setup echoes its status (wired / not-wired / skipped:not-installed,
# or a fallback note like cursor's "project rule"); a pack that defined none would
# print "unsupported" (all bundled packs implement it).
global_report() {
  local mode="$1" canon="$2" a status d
  echo "global instructions: $canon"
  for d in "$FLEET_PACKS_DIR"/*/; do
    a="$(basename "$d")"
    [ -f "$FLEET_PACKS_DIR/$a/pack.sh" ] || continue
    status="$( ( fleet_load_pack "$a" >/dev/null 2>&1 \
                 && declare -F pack_global_setup >/dev/null \
                 && pack_global_setup "$canon" "$mode" ) 2>/dev/null || true )"
    printf '  %-12s %s\n' "$a" "${status:-unsupported}"
  done
}

# ---------- global skills (per-user skills synced from the engine templates) ----
# Same model as the instructions file: the engine's templates/skills/ is the
# SOURCE; $FLEET_GLOBAL_SKILLS (default ~/.agents/skills, the agentskills.io
# personal dir) is the per-user install every project's sessions see; and
# ~/.claude/skills/<name> is a per-skill symlink (Claude Code only reads its own
# dir). This replaces hand-copying template skills to the user level and the
# drift that follows. There is deliberately NO bulk no-name sync: an installed
# copy may carry local customization, so `status` shows the drift and the human
# names what to replace (the previous copy is kept in a sibling skills.bak/).
global_skills_dir() { echo "${FLEET_GLOBAL_SKILLS:-$HOME/.agents/skills}"; }

global_skill_state() {  # <name> -> in-sync | drifted | not-installed
  local tpl="$SELF_DIR/../templates/skills/$1" dst; dst="$(global_skills_dir)/$1"
  [ -d "$dst" ] || { echo not-installed; return; }
  if diff -rq "$tpl" "$dst" >/dev/null 2>&1; then echo in-sync; else echo drifted; fi
}

global_skill_wiring() {  # <name> -> linked | copy | missing   (the ~/.claude/skills side)
  local c="$HOME/.claude/skills/$1" dst; dst="$(global_skills_dir)/$1"
  if [ -L "$c" ] && [ "$(readlink -f "$c" 2>/dev/null)" = "$(readlink -f "$dst" 2>/dev/null)" ]; then
    echo linked
  elif [ -e "$c" ]; then echo copy; else echo missing; fi
}

global_skills_status() {
  local d name
  echo "engine templates/skills -> $(global_skills_dir)   (claude reads per-skill symlinks in ~/.claude/skills)"
  for d in "$SELF_DIR/../templates/skills"/*/; do
    name="$(basename "$d")"
    [ -f "$d/SKILL.md" ] || continue
    printf '  %-24s %-14s claude:%s\n' "$name" "$(global_skill_state "$name")" "$(global_skill_wiring "$name")"
  done
  echo "sync (replaces; previous copy kept in a sibling skills.bak/):  fleet global skills sync <name>... | --all"
}

global_skill_sync() {  # <name> — install/refresh one skill + (re)wire the claude symlink
  local name="$1" tpl dst claude bak cbak note=""
  tpl="$SELF_DIR/../templates/skills/$name"
  dst="$(global_skills_dir)/$name"; claude="$HOME/.claude/skills/$name"
  # Backups go in SIBLING skills.bak/ dirs, never inside a skills dir the CLIs
  # scan: a <name>.bak/ left in place still holds a SKILL.md and would register
  # as a duplicate skill.
  bak="$(global_skills_dir).bak/$name"; cbak="$HOME/.claude/skills.bak/$name"
  [ -f "$tpl/SKILL.md" ] || { echo "error: no template skill '$name' (list: fleet global skills)" >&2; return 2; }
  mkdir -p "$(dirname "$dst")" "$HOME/.claude/skills"
  if [ -d "$dst" ] && ! diff -rq "$tpl" "$dst" >/dev/null 2>&1; then
    mkdir -p "$(dirname "$bak")"; rm -rf "$bak"; mv "$dst" "$bak"; note=" (previous kept at $bak)"
  fi
  [ -d "$dst" ] || cp -R "$tpl" "$dst"
  # Claude wiring: a real dir/file there (a hand copy) is backed up, a stale
  # symlink is replaced; the result is always <claude>/<name> -> canonical.
  if [ -e "$claude" ] && [ ! -L "$claude" ]; then
    mkdir -p "$(dirname "$cbak")"; rm -rf "$cbak"; mv "$claude" "$cbak"; note="$note (claude copy kept at $cbak)"
  fi
  [ -L "$claude" ] && rm -f "$claude"
  ln -s "$dst" "$claude"
  echo "  $name: synced$note"
}

cmd_global_skills() {  # fleet global skills [sync <name>...|--all]
  case "${1:-status}" in
    status) global_skills_status ;;
    sync)
      shift
      [ $# -ge 1 ] || { echo "usage: fleet global skills sync <name>... | --all" >&2; exit 2; }
      local names=() d rc=0
      if [ "$1" = "--all" ]; then
        for d in "$SELF_DIR/../templates/skills"/*/; do
          [ -f "$d/SKILL.md" ] && names+=("$(basename "$d")")
        done
      else
        names=("$@")
      fi
      local n; for n in "${names[@]}"; do global_skill_sync "$n" || rc=2; done
      return "$rc" ;;
    *) echo "usage: fleet global skills [sync <name>... | --all]" >&2; exit 2 ;;
  esac
}

cmd_global() {  # fleet global [install|status|edit|skills ...]
  local canon; canon="$(global_canon)"
  case "${1:-install}" in
    status)      global_report status "$canon" ;;
    edit)        [ -e "$canon" ] || global_ensure_canon "$canon"; exec "${EDITOR:-vi}" "$canon" ;;
    skills)      shift; cmd_global_skills "$@" ;;
    install|"")  global_ensure_canon "$canon"; global_report install "$canon"
                 echo "edit it:  fleet global edit   ·   re-wire after enabling a pack:  fleet global"
                 echo "per-user skills from the engine templates:  fleet global skills" ;;
    *)           echo "usage: fleet global [install|status|edit|skills [sync <name>...|--all]]" >&2; exit 2 ;;
  esac
}

# ---------- machines / status / peek / send ----------

cmd_machines() {
  if [ "${1:-}" = add ]; then
    shift
    local mname="${1:-}" mhost="${2:-}" mcont="${3:-}" mtmux="${4:-}"
    { [ -z "$mname" ] || [ -z "$mhost" ]; } && {
      echo "usage: fleet machines add <name> <ssh-host> [container] [tmux]" >&2
      echo "  writes $FLEET_MACHINES/<name>.env; add it to a project with MACHINES=" >&2
      exit 2; }
    mkdir -p "$FLEET_MACHINES"
    local f="$FLEET_MACHINES/$mname.env"
    [ -e "$f" ] && { echo "error: machine '$mname' already exists ($f)" >&2; exit 1; }
    {
      echo "# fleet machine '$mname' (a VM running the deploy/ container)."
      echo "MACHINE_HOST=\"$mhost\""
      echo "MACHINE_CONTAINER=\"${mcont:-fleet}\""
      echo "MACHINE_TMUX=\"${mtmux:-fleet}\""
      echo "MACHINE_ENGINE_DIR=\"agent-fleet\""
      echo "# MACHINE_PROJECT=\"<name on that box, if different from the project>\""
    } > "$f"
    echo "[fleet] wrote $f — enable it per project with MACHINES=\"local $mname\" (or fleet-init --machine)"
    return 0
  fi
  echo "project : $PROJ_NAME"
  echo "selected: $(fleet_machines)"
  local m
  for m in $(fleet_machines); do
    if fleet_load_machine "$m" 2>/dev/null; then
      if [ "$M_LOCAL" = 1 ]; then
        printf '  %-12s local (tmux %s)\n' "$m" "$M_TMUX"
      else
        printf '  %-12s %s (container %s, tmux %s, engine ~/%s, project %s)\n' \
          "$m" "$M_HOST" "$M_CONTAINER" "$M_TMUX" "$M_ENGINE" "$M_PROJECT"
      fi
    else
      printf '  %-12s (unresolved)\n' "$m"
    fi
  done
  if ls "$FLEET_MACHINES"/*.env >/dev/null 2>&1; then
    echo "registry pool ($FLEET_MACHINES):"
    ls "$FLEET_MACHINES"/*.env 2>/dev/null | sed 's#.*/##; s#\.env$##; s#^#  #'
  else
    echo "registry pool: empty — add one at $FLEET_MACHINES/<name>.env (template: templates/machine.env)"
  fi
}

cmd_peek() {  # fleet peek <machine> <window> — dump a session's terminal
  local mname="${1:-}" win="${2:-}"
  { [ -z "$mname" ] || [ -z "$win" ]; } && { echo "usage: fleet peek <machine> <window>" >&2; exit 2; }
  fleet_valid_name "$win" "window name" || exit 2   # threads through ssh/docker unquoted
  fleet_load_machine "$mname" || exit 2
  # Finished dispatches rename to _done-<name> (still peekable under the old name).
  local target="$win"
  if [ "$M_LOCAL" = 1 ]; then
    if ! tmux list-windows -t "$M_TMUX" -F '#{window_name}' 2>/dev/null | grep -Fxq -- "$win"; then
      if tmux list-windows -t "$M_TMUX" -F '#{window_name}' 2>/dev/null | grep -Fxq -- "_done-$win"; then
        target="_done-$win"
      fi
    fi
    tmux capture-pane -p -t "$M_TMUX:$target" 2>/dev/null \
      || { echo "error: no window '$win' in local tmux '$M_TMUX'" >&2; exit 1; }
  else
    # Success: one ssh+docker hop. On failure, diagnose which layer broke
    # (ssh host / container / missing window) instead of a opaque "could not capture".
    ssh -o ConnectTimeout=8 -o BatchMode=yes "$M_HOST" \
      "docker exec $M_CONTAINER tmux capture-pane -p -t $M_TMUX:$win 2>/dev/null \
       || docker exec $M_CONTAINER tmux capture-pane -p -t $M_TMUX:_done-$win" 2>/dev/null \
      || {
        if ! ssh -o ConnectTimeout=5 -o BatchMode=yes "$M_HOST" true >/dev/null 2>&1; then
          echo "error: cannot reach $mname ($M_HOST) via ssh" >&2
        elif ! ssh -o ConnectTimeout=5 -o BatchMode=yes "$M_HOST" \
          "docker exec $M_CONTAINER true" >/dev/null 2>&1; then
          echo "error: docker exec failed on $mname (container '$M_CONTAINER')" >&2
        else
          echo "error: no window '$win' in $mname tmux session '$M_TMUX'" >&2
        fi
        exit 1
      }
  fi
}

cmd_send() {  # fleet send <machine> <window> "<text>" — type text+Enter
  local mname="${1:-}" win="${2:-}"; shift 2 2>/dev/null || true
  local text="$*"
  { [ -z "$mname" ] || [ -z "$win" ] || [ -z "$text" ]; } && { echo "usage: fleet send <machine> <window> \"<text>\"" >&2; exit 2; }
  fleet_valid_name "$win" "window name" || exit 2   # threads through ssh/docker unquoted
  fleet_load_machine "$mname" || exit 2
  if [ "$M_LOCAL" = 1 ]; then
    tmux send-keys -t "$M_TMUX:$win" "$text" Enter && echo "sent to $mname:$win"
  else
    # Text rides as base64 (decoded on the remote), so quotes/`$`/backticks are
    # never re-evaluated by the remote shell — no injection, any text goes.
    local b64; b64="$(printf '%s' "$text" | base64 | tr -d '\n')"
    ssh "$M_HOST" "docker exec $M_CONTAINER bash -lc 'tmux send-keys -t $M_TMUX:$win \"\$(printf %s $b64 | base64 -d)\" Enter'" && echo "sent to $mname:$win"
  fi
}

cmd_status() {  # fleet status [--all] [--json] — the whole tree
  exec python3 "$SELF_DIR/fleet-status.py" "$@"
}

cmd_context() {  # fleet context [--role R] [--json] [--budget N] — front-loaded context per role
  exec python3 "$SELF_DIR/fleet-context.py" "$@"
}

cmd_feedback() {  # fleet feedback <config|seen|record|list|prune> — conversation-feedback routine state
  # `config` reports the resolved model/runner knobs for the routine (docs/04).
  # Feedback is machine-wide (carved out of fleet_resolve_conf above), so source
  # default.env directly for overrides, then fall back to the FLEET_DEF_* built-ins.
  if [ "${1:-}" = config ]; then
    shift
    [ -f "$FLEET_ROOT/default.env" ] && . "$FLEET_ROOT/default.env"
    local mc="${FEEDBACK_MODEL_COMPRESS-$FLEET_DEF_FEEDBACK_MODEL_COMPRESS}"
    local md="${FEEDBACK_MODEL_DISTILL-$FLEET_DEF_FEEDBACK_MODEL_DISTILL}"
    local mr="${FEEDBACK_RUNNER:-$FLEET_DEF_FEEDBACK_RUNNER}"
    if [ "${1:-}" = --json ]; then
      printf '{"model_compress":"%s","model_distill":"%s","runner":"%s","notes_dir":"%s","digests_dir":"%s"}\n' \
        "$mc" "$md" "$mr" "$FLEET_ROOT/feedback-notes" "$FLEET_ROOT/feedback-digests"
    else
      echo "FEEDBACK_MODEL_COMPRESS=$mc"
      echo "FEEDBACK_MODEL_DISTILL=$md"
      echo "FEEDBACK_RUNNER=$mr"
      echo "FEEDBACK_NOTES_DIR=$FLEET_ROOT/feedback-notes"
      echo "FEEDBACK_DIGESTS_DIR=$FLEET_ROOT/feedback-digests"
    fi
    return 0
  fi
  exec python3 "$SELF_DIR/fleet-feedback.py" "$@"
}

cmd_issue() {  # fleet issue new|start|review|block|done|bootstrap — the GitHub issue queue
  # The queue keys live in the resolved project .env (sourced, not exported):
  # hand them to the helper explicitly.
  exec env QUEUE_KIND="${QUEUE_KIND:-none}" QUEUE_GITHUB_REPO="${QUEUE_GITHUB_REPO:-}" \
    QUEUE_GITHUB_PROJECT="${QUEUE_GITHUB_PROJECT:-}" \
    QUEUE_GITHUB_PROJECT_OWNER="${QUEUE_GITHUB_PROJECT_OWNER:-}" \
    QUEUE_NEEDS_LABEL="${QUEUE_NEEDS_LABEL:-}" \
    FLEET_ISSUE_PROJECT="$PROJ_NAME" WT_HOME="${WT_HOME:-}" HUB="${HUB:-}" \
    python3 "$SELF_DIR/fleet-issue.py" "$@"
}

cmd_route() {  # fleet route [--difficulty D] [--kind K] [--escalate] [--task T]
  exec python3 "$SELF_DIR/fleet-route.py" "$@"
}

# ---------- dispatch ----------

case "$sub" in
  hub)         cmd_hub ;;
  w)           cmd_worker "$@" ;;
  dispatch)      cmd_dispatch "$@" ;;
  _dispatch-run) cmd_dispatch_run "$@" ;;
  attach)        cmd_attach ;;
  wait)          cmd_wait "$@" ;;
  retry)         cmd_retry "$@" ;;
  global)        cmd_global "$@" ;;
  r)           cmd_remote "$@" ;;
  ls)          cmd_ls ;;
  del)         cmd_del "${1:-}" ;;
  prune)       cmd_prune "$@" ;;
  refresh)     cmd_refresh "${1:-}" ;;
  add-agent)   cmd_add_agent "${1:-}" ;;
  agents)      cmd_agents ;;
  gate)        cmd_gate "$@" ;;
  judge)       cmd_judge "$@" ;;
  race)        cmd_race "$@" ;;
  fanin)       cmd_fanin "$@" ;;
  chats)       cmd_chats "$@" ;;
  doctor)      cmd_doctor "$@" ;;
  sync-remote) cmd_sync_remote "${1:-}" ;;
  machines)    cmd_machines "$@" ;;
  status)      cmd_status "$@" ;;
  context)     cmd_context "$@" ;;
  feedback)    cmd_feedback "$@" ;;
  issue)       cmd_issue "$@" ;;
  peek)        cmd_peek "$@" ;;
  send)        cmd_send "$@" ;;
  route)       cmd_route "$@" ;;
esac
