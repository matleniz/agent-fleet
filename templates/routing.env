# agent-fleet task routing preferences.
# Copy to ~/.config/fleet/routing.env (global) or set in project .env.
# Used by `fleet route` and `fleet dispatch --auto`.
#
# Precedence: CLI flags/env > project .env > routing.env > default.env > built-ins.

# Ordered candidate pack:model lists for each task difficulty.
# Cursor is not first by default (quota considerations).
ROUTE_EASY="gemini opencode:haiku antigravity copilot"
ROUTE_MEDIUM="gemini opencode antigravity copilot cursor"
ROUTE_HARD="gemini opencode antigravity copilot cursor claude:sonnet"

# Escalation preference list (used when --escalate is given or gate fails)
ROUTE_ESCALATE="claude:sonnet claude:opus"

# Claude access policy:
#   escalate-only (default) — Claude reserved for coordinator and explicit escalation
#   allowed                 — Claude can be chosen in normal difficulty routes
#   never                   — Claude never chosen even on escalation
ROUTE_CLAUDE="escalate-only"

# Maximum sub-worker dispatch recursion depth (prevents runaway dispatch chains)
ROUTE_MAX_DEPTH=2

# Optional task scorer hook command (empty = use coordinator tag / default difficulty)
# ROUTE_SCORER=""

# Kind-specific overrides (override difficulty preference lists when --kind K is specified)
# ROUTE_KIND_DOC="gemini opencode:haiku"
# ROUTE_KIND_READ="antigravity gemini"
# ROUTE_KIND_CODE="copilot opencode"
